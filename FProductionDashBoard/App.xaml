<Application x:Class="FProductionDashBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:FProductionDashBoard">
    
    <Application.Resources>
        <ResourceDictionary>
            <!-- 套件匯入 -->
            <ResourceDictionary.MergedDictionaries>
                <!--#region Material Design 套件資源 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Window.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ListBox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ToolTip.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ToggleButton.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.CheckBox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.RadioButton.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Slider.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TabControl.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ProgressBar.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBlock.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PasswordBox.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Menu.xaml"/>
                
                <!-- 已改由 PaletteHelper 在程式碼裡設定顏色 -->
                <!--<ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Blue.xaml"/>-->
                <!--<ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Lime.xaml"/>-->
                <!--#endregion-->

                <!-- 自訂樣式/設定資源 -->
                <ResourceDictionary Source="/Themes/CardStyles.xaml"/>
                <ResourceDictionary Source="/Themes/Typography.xaml"/>
                <ResourceDictionary Source="/Themes/Spacing.xaml"/>
                <ResourceDictionary Source="/Themes/Theme.Light.xaml"/>

                <!-- 語言資源 (預設預言) -->
                <ResourceDictionary Source="/Resources/StrResources.zh-TW.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!--#region 自訂 Converter -->
            <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <local:BoolToAlertIconConverter x:Key="BoolToAlertConverter"/>
            <local:IntToColorConverter x:Key="IntToColorConverter"/>
            <local:StringNullOrEmptyToVisibilityConverter x:Key="PlaceholderConverter"/>
            <local:CollapseWidthConverter x:Key="CollapseWidthConverter"/>
            <local:EqualToConverter x:Key="EqualToConverter"/>
            <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:StringHasValueToVisibilityConverter x:Key="StringHasValueToVisibilityConverter"/>
            <local:TimeSpanToHhmmConverter x:Key="TimeSpanToHhmmConverter"/>
            <local:TranslationZhTwConverter x:Key="TranslationZhTwConverter"/>
            <!--#endregion-->
            
        </ResourceDictionary>
        
    </Application.Resources>

</Application>
