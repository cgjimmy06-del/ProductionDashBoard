<Window x:Class="FProductionDashBoard.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FProductionDashBoard"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterOwner"
        Title="DialogWindow" SizeToContent="WidthAndHeight"
        d:DesignHeight="400" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 左側狀態燈號 -->
            <RowDefinition Height="Auto"/>
            <!-- 主體內容 -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="16" Margin="10" HorizontalAlignment="Center"
                   d:Text="視窗訊息" Text="{Binding DialogInfoString}"/>
        
        <!-- 預留一個 ContentControl 來載入不同的 UserControl -->
        <ContentControl Grid.Row="1" x:Name="DialogContent"/>

        <!-- 錯誤訊息 -->
        <TextBlock Grid.Row="2" Margin="2" HorizontalAlignment="Center"
                   d:Text="視窗訊息" Text="{Binding DialogErrorString}"
                   Foreground="Red"/>
        <!-- 確認/取消 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="40, 10" Style="{DynamicResource ConfirmButtonStyle}"
                    Content="{DynamicResource ConfirmButton}" 
                    Command="{Binding ConfirmCommand}">
            </Button>
            <Button Margin="40, 10" Style="{DynamicResource ConfirmButtonStyle}"
                    Content="{DynamicResource CancelButton}" 
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
