<Window x:Class="FProductionDashBoard.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FProductionDashBoard"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Loading Window" Height="200" Width="300"
        Loaded="Window_Loaded">
    <DockPanel Margin="20">

        <TextBlock Margin="10" Text="請稍後..." FontSize="16"
                   DockPanel.Dock="Top" TextAlignment="Center"/>


        <Button Content="取消" Width="80" DockPanel.Dock="Bottom"
                Command="{Binding CancelCommand}" />
    </DockPanel>
</Window>
