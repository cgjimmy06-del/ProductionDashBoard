<Window x:Class="FProductionDashBoard.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:FProductionDashBoard.ViewModels"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="320" SizeToContent="Height"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="28,24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Direction="270"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center" MinWidth="220">

            <!-- Icon（依 Mode 切換 Kind / 顏色） -->
            <materialDesign:PackIcon x:Name="LoadingIcon"
                                     Width="44" Height="44"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,14">
                <materialDesign:PackIcon.RenderTransform>
                    <RotateTransform CenterX="22" CenterY="22"/>
                </materialDesign:PackIcon.RenderTransform>
                <materialDesign:PackIcon.Style>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Kind" Value="Sync"/>
                        <Setter Property="Foreground" Value="{DynamicResource ProcessingBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:LoadingMode.LogoutCountdown}">
                                <Setter Property="Kind" Value="AlertCircleOutline"/>
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:LoadingMode.CardReader}">
                                <Setter Property="Kind" Value="CardAccountDetailsOutline"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>

            <!-- 訊息文字 -->
            <TextBlock Text="{Binding Message}"
                       FontSize="{StaticResource FontSizeMedium}"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- 倒計時（僅 LogoutCountdown 模式） -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        Visibility="{Binding CountdownVisibility}">
                <TextBlock Text="{Binding CountdownSeconds}"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Bottom"/>
                <TextBlock Text=" " VerticalAlignment="Bottom"/>
                <TextBlock Text="{DynamicResource LoadingCountdownSuffix}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,5"/>
            </StackPanel>

            <!-- 進度條（僅 Processing 模式） -->
            <ProgressBar Width="220" Height="4"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Value="{Binding ProgressValue}"
                         Visibility="{Binding ProgressBarVisibility}"
                         Margin="0,0,0,16"/>

            <!-- 取消 / 延長按鈕 -->
            <Button HorizontalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ConfirmButtonStyle}">
                        <Setter Property="Content" Value="{DynamicResource LoadingCancelButton}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:LoadingMode.LogoutCountdown}">
                                <Setter Property="Content" Value="{DynamicResource LoadingExtendButton}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>
    </Border>
</Window>
