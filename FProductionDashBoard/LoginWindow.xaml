<Window x:Class="FProductionDashBoard.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FProductionDashBoard"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{Binding AppVersion, StringFormat=PDB Login v{0}}" 
        Height="400" Width="300">

    <StackPanel Margin="40, 10">
        <TextBlock Text="Language：" Margin="5,5,5,0"/>
        <ComboBox ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  Margin="5"/>
        
        <TextBlock Text="Server：" Margin="5,5,5,0"/>
        <ComboBox ItemsSource="{Binding Servers}"
                  SelectedItem="{Binding SelectedServer}"
                  Margin="5"/>

        <TextBlock Text="Account：(staff number)" Margin="5,5,5,0"/>
        <TextBox Text="{Binding UserId}" Margin="5"/>

        <TextBlock Text="Password：" Margin="5,5,5,0"/>
        <PasswordBox x:Name="PasswordBox" Margin="5,5,5,0"
                     materialDesign:HintAssist.Hint="請輸入密碼"
                     materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay}"/>
        <TextBlock Text="{Binding Errorinfo}" d:Text="error" Margin="0,0,0,20"
                   Foreground="Red"/>

        <CheckBox Content="Remember me" Margin="5"
                  HorizontalAlignment="Center"
              IsChecked="{Binding RememberMe}" />

        <Button Content="Login" Background="LightGray" Width="100"
                Command="{Binding LoginCommand}"
                CommandParameter="Normal"
                IsDefault="true"/>

        <Button Margin="5" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Command="{Binding LoginCommand}" 
                CommandParameter="Visitor">
            <TextBlock Text="Visitor" TextDecorations="Underline" Foreground="Blue"/>
        </Button>

    </StackPanel>

</Window>
