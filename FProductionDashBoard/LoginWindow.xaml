<Window x:Class="FProductionDashBoard.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:FProductionDashBoard"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{Binding AppVersion, StringFormat=PDB Login v{0}}" 
        Height="420" Width="300">

    <StackPanel Margin="40, 10">
        <TextBlock Text="{DynamicResource LanguageText}" Margin="5,5,5,0"/>
        <ComboBox ItemsSource="{Binding Languages}" Margin="5"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="CultureCode"
                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding LanguageChangeCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>

        <TextBlock Text="{DynamicResource ServerText}" Margin="5,5,5,0"/>
        <ComboBox ItemsSource="{Binding Servers}"
                  SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                  Margin="5"/>

        <TextBlock Text="{DynamicResource AccountText}" Margin="5,5,5,0"/>
        <TextBox Text="{Binding UserId}" Margin="5" Padding="4"
                 BorderBrush="Black"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource RequiredText}"
                 materialDesign:HintAssist.IsFloating="False"/>

        <TextBlock Text="{DynamicResource PasswordText}" Margin="5,5,5,0"/>
        <PasswordBox x:Name="PasswordBox" Margin="5,5,5,0" Padding="4"
                     BorderBrush="Black"
                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                     materialDesign:HintAssist.Hint="{DynamicResource RequiredText}"
                     materialDesign:HintAssist.IsFloating="False"
                     materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay}"/>
        <TextBlock Text="{Binding Errorinfo}" d:Text="Error" Margin="5,0,0,15"
                   Foreground="{DynamicResource ErrorBrush}"/>

        <CheckBox Content="{DynamicResource RememberMeCheck}" Margin="5"
                  HorizontalAlignment="Center"
              IsChecked="{Binding RememberMe}" />

        <Button Content="{DynamicResource LoginButton}" 
                Background="LightGray" Foreground="Black" Width="100"
                Command="{Binding LoginCommand}"
                CommandParameter="Normal" IsDefault="true"/>

        <Button Margin="5" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                Command="{Binding LoginCommand}" 
                CommandParameter="Visitor">
            <TextBlock Text="{DynamicResource VisitorButton}" TextDecorations="Underline" Foreground="Blue"/>
        </Button>

    </StackPanel>

</Window>
