<Window x:Class="FProductionDashBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FProductionDashBoard"
        xmlns:localuc="clr-namespace:FProductionDashBoard.UserControls"
        xmlns:localvm="clr-namespace:FProductionDashBoard.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        Title="{Binding AppVersion, StringFormat=ProductionDashBoard -- V{0}}" 
        Height="600" Width="1000" Icon="appIcon.ico"
        d:Height="450" d:Width="800">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 外部資源 -->
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <!-- 本地資源 -->
            <Storyboard x:Key="CollapseNav">
                <DoubleAnimation Storyboard.TargetProperty="Width"
                             To="50" Duration="0:0:0.3" />
            </Storyboard>
            <Storyboard x:Key="ExpandNav">
                <DoubleAnimation Storyboard.TargetProperty="Width"
                             To="200" Duration="0:0:0.3" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Menu 區域 -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MaterialDesignPaper}">
            <MenuItem Header="_檔案">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="File" Width="20" Height="20"/>
                </MenuItem.Icon>
                <MenuItem Header="開啟" InputGestureText="Ctrl+O"/>
                <MenuItem Header="儲存" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="結束"/>
            </MenuItem>

            <MenuItem Header="_編輯">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Edit" Width="20" Height="20"/>
                </MenuItem.Icon>
                <MenuItem Header="剪下"/>
                <MenuItem Header="複製"/>
                <MenuItem Header="貼上"/>
            </MenuItem>
        </Menu>

        <!-- ToolBar 區域 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="新增">
                    <materialDesign:PackIcon Kind="Add" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="開啟">
                    <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="儲存">
                    <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                </Button>
                <Separator/>
                <Button ToolTip="剪下">
                    <materialDesign:PackIcon Kind="ContentCut" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="複製">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="貼上">
                    <materialDesign:PackIcon Kind="ContentPaste" Width="20" Height="20"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- StatusBar 區域 -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource MaterialDesignPaper}"
                   Foreground="{DynamicResource MaterialDesignBody}">

            <StatusBarItem>
                <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                            Width="120"  Height="10" Value="{Binding ProgressValue}"
                             VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ProgressString}" d:Text="Idle"
                               VerticalAlignment="Center" Margin="5,0,8,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" d:Text="welcome 使用者"
                        Text="{Binding SystemUser.Name, StringFormat=Welcome! {0}}" 
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" d:Text="xxxx/xx/xx xx:xx"
                        Text="{Binding CurrentTime}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- 主區域(中) -->
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <!-- 導覽列 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 主內容 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 導覽列 -->
            <Border Grid.Column="0" Margin="0" d:Width="200"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    Width="{Binding IsCollapsedNav, Converter={StaticResource CollapseWidthConverter}}">
                <StackPanel Margin="0">
                    <!-- 收合按鈕"☰" -->
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                            Command="{Binding CollapseNavCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="Home" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="首頁" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- 導覽內容 -->
                    <RadioButton Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="Home" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="項目1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>
            </Border>

            <!-- 儀錶板主顯示區 -->
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <!-- 主內容UI (預設2欄儀表板卡片) ScrollViewer/WrapPanel -->
                <Grid Grid.Row="0">
                    <!-- 設備卡片管理區 (可能之後要做成user control) -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 設備卡片陣列 -->
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <localuc:DeviceCard Style="{StaticResource MainCardStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 卡片操作區 (上下載未加入事件) -->
                            <Border Margin="2" Padding="2" Height="50"
                                        BorderBrush="Gray" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Margin="2"
                                                HorizontalAlignment="Center">
                                    <Button Height="40" Width="80" Margin="5,0"
                                        Command="{Binding DCardManageCommand}" >
                                        <materialDesign:PackIcon Kind="ShapeRectangleAdd"
                                                     Width="30" Height="30"/>
                                    </Button>
                                    <Button Height="40" Width="80" Margin="5,0" Padding="0"
                                        Command="{Binding DCardManageCommand}" >
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="LightningBolt"
                                                     Width="20" Height="20" VerticalAlignment="Top"/>
                                            <materialDesign:PackIcon Kind="FileUpload"
                                                     Width="30" Height="30"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Height="40" Width="80" Margin="5,0" Padding="0"
                                        Command="{Binding DCardManageCommand}" >
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="LightningBolt"
                                                     Width="20" Height="20" VerticalAlignment="Top"/>
                                            <materialDesign:PackIcon Kind="FileDownload"
                                                     Width="30" Height="30"/>
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- GridSplitter -->
                <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Height="5"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="Gray"/>
                <!-- 狀態訊息區 -->
                <Border Grid.Row="2" BorderBrush="Gray" 
                    BorderThickness="1" Margin="5" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <!-- 即時狀態窗 -->
                        <ListBox Grid.Column="0" x:Name="LogListBox" 
                                 Background="{DynamicResource BackgroundBrush}"
                                 ItemsSource="{Binding CurrentLogs}"
                                 local:ListBoxBehavior.AutoScrollToEnd="{Binding AutoScrollEnabled}">
                            <!-- 行高/內距/文字大小/行距 -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="FontWeight"  Value="Semibold" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <!-- 時間StringFormat={}[{0:HH:mm:ss}] -->
                                        <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}" 
                                Foreground="{Binding Color}" Margin="0,0,5,0"/>
                                        <!-- 圖示 (PackIconKind enum 綁定) -->
                                        <materialDesign:PackIcon Kind="{Binding Icon}" 
                                         Foreground="{Binding Color}" 
                                         Width="15" Height="15" Margin="0,0,5,0"/>
                                        <!-- 訊息 -->
                                        <TextBlock Text="{Binding Message}" 
                                Foreground="{Binding Color}" Margin="0,0,5,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 狀態窗操作介面 -->
                        <StackPanel Grid.Column="1" Margin="2" HorizontalAlignment="Center">
                            <Button Width="25" Height="25" Margin="1"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource FunctionButtonStyle}"
                                    Command="{Binding AutoScrollCommand}">
                                <materialDesign:PackIcon Kind="Pin"
                                                     Width="20" Height="20"/>
                            </Button>
                            <Button Width="25" Height="25" Margin="1"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource FunctionButtonStyle}"
                                    Command="{Binding ErrorModeCommand}">
                                <materialDesign:PackIcon Kind="AlertOutline"
                                                     Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
