<Window x:Class="FProductionDashBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:FProductionDashBoard"
        xmlns:localuc="clr-namespace:FProductionDashBoard.UserControls"
        xmlns:localvm="clr-namespace:FProductionDashBoard.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        Title="{Binding AppVersion, StringFormat=ProductionDashBoard  [ Ver {0} ]}"
        Height="800" Width="1280" Icon="appIcon.ico">
    <!-- window載入事件 -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <!-- 資源匯入 -->
    <Window.Resources>
        <ResourceDictionary>
            <!-- 外部資源 -->
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <!-- 本地資源 -->
            <Storyboard x:Key="CollapseNav">
                <DoubleAnimation Storyboard.TargetProperty="Width"
                             To="50" Duration="0:0:0.3" />
            </Storyboard>
            <Storyboard x:Key="ExpandNav">
                <DoubleAnimation Storyboard.TargetProperty="Width"
                             To="200" Duration="0:0:0.3" />
            </Storyboard>

            <!-- ViewModel 綁定 User Control -->
            <DataTemplate DataType="{x:Type localvm:DeviceCardContainerViewModel}">
                <localuc:DeviceCardContainer />
            </DataTemplate>
            <DataTemplate DataType="{x:Type localvm:SettingViewModel}">
                <localuc:SettingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type localvm:HardwareViewModel}">
                <localuc:HardwareView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type localvm:SystemSettingsViewModel}">
                <localuc:SystemSettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type localvm:HomeViewModel}">
                <localuc:HomeView />
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Menu 區域 -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource BackgroundBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}">
            <MenuItem Header="{DynamicResource MenuFile}">
                <MenuItem Header="{DynamicResource MenuFileExit}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource MenuTools}">
                <MenuItem Header="{DynamicResource MenuViewLanguage}">
                    <MenuItem Header="中文" IsCheckable="True"
                              IsChecked="{Binding SystemSettings.CurrentLanguage,
                                  Converter={StaticResource EqualToConverter},
                                  ConverterParameter='zh-TW', Mode=OneWay}"
                              Command="{Binding SystemSettings.SetLanguageCommand}"
                              CommandParameter="zh-TW"/>
                    <MenuItem Header="English" IsCheckable="True"
                              IsChecked="{Binding SystemSettings.CurrentLanguage,
                                  Converter={StaticResource EqualToConverter},
                                  ConverterParameter='en-US', Mode=OneWay}"
                              Command="{Binding SystemSettings.SetLanguageCommand}"
                              CommandParameter="en-US"/>
                    <MenuItem Header="Tiếng Việt" IsCheckable="True"
                              IsChecked="{Binding SystemSettings.CurrentLanguage,
                                  Converter={StaticResource EqualToConverter},
                                  ConverterParameter='vi-VN', Mode=OneWay}"
                              Command="{Binding SystemSettings.SetLanguageCommand}"
                              CommandParameter="vi-VN"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource MenuViewTheme}">
                    <MenuItem Header="{DynamicResource SsThemeLight}" IsCheckable="True"
                              IsChecked="{Binding SystemSettings.CurrentIsLight, Mode=OneWay}"
                              Command="{Binding SystemSettings.SetThemeCommand}"
                              CommandParameter="False"/>
                    <MenuItem Header="{DynamicResource SsThemeDark}" IsCheckable="True"
                              IsChecked="{Binding SystemSettings.CurrentIsDark, Mode=OneWay}"
                              Command="{Binding SystemSettings.SetThemeCommand}"
                              CommandParameter="True"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource MenuToolsSettings}"
                          Command="{Binding SwitchModeCommand}"
                          CommandParameter="{x:Static localvm:NavMode.SystemSettings}"
                          InputGestureText="Ctrl+,"/>
            </MenuItem>
        </Menu>

        <!-- ToolBar 區域 -->
        <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource PrimaryBackgroundBrush}">
            <ToolBar Loaded="ToolBar_Loaded"
                     Background="{DynamicResource PrimaryBackgroundBrush}">
                <Button ToolTip="新增" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="Add" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="開啟" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="儲存" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                </Button>
                <Separator/>
                <Button ToolTip="剪下" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="ContentCut" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="複製" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="貼上" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="ContentPaste" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="測試" Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding TestCommand}"
                        Visibility="{x:Static local:App.DebugVisibility}">
                    <materialDesign:PackIcon Kind="AbTesting" Width="20" Height="20"/>
                </Button>
            </ToolBar>
            <!-- 視圖控制 ToolBar -->
            <ToolBar Loaded="ToolBar_Loaded"
                     Background="{DynamicResource PrimaryBackgroundBrush}">
                <ToggleButton ToolTip="{DynamicResource ToggleLogPanelTooltip}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              IsChecked="{Binding IsLogPanelVisible, Mode=TwoWay}">
                    <materialDesign:PackIcon Kind="ConsoleLine" Width="20" Height="20"/>
                </ToggleButton>
                <Separator/>
                <Button ToolTip="{DynamicResource LayoutSingleTooltip}" Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding SetLayoutCommand}"
                        CommandParameter="{x:Static localvm:LayoutMode.Single}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.Single}">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18"/>
                </Button>
                <Button ToolTip="{DynamicResource LayoutHSplitTooltip}" Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding SetLayoutCommand}"
                        CommandParameter="{x:Static localvm:LayoutMode.HorizontalSplit}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.HorizontalSplit}">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon Kind="ViewSplitVertical" Width="18" Height="18"/>
                </Button>
                <Button ToolTip="{DynamicResource LayoutVSplitTooltip}" Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding SetLayoutCommand}"
                        CommandParameter="{x:Static localvm:LayoutMode.VerticalSplit}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.VerticalSplit}">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon Kind="ViewSplitHorizontal" Width="18" Height="18"/>
                </Button>
                <Button ToolTip="{DynamicResource LayoutQuadTooltip}" Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding SetLayoutCommand}"
                        CommandParameter="{x:Static localvm:LayoutMode.Quad}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.Quad}">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon Kind="ViewGrid" Width="18" Height="18"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- StatusBar 區域 -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource PrimaryBackgroundBrush}"
                   Foreground="{DynamicResource MaterialDesignBody}">
            <!-- 進度條訊息 -->
            <StatusBarItem>
                <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Width="120" Height="10" Margin="5,0"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                             VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ProgressString}" d:Text="Idle"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
            </StatusBarItem>
            <!-- 讀卡機狀態 -->
            <StatusBarItem>
                <TextBlock Text="[Reader" d:Text="[Reader"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StatusBarItem>
            <StatusBarItem ToolTip="{Binding CardReaderStatusTooltip}">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextDisabledBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardReaderConnected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCardReaderConnected}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource IdleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StatusBarItem>
            <!-- 網路連線狀態 -->
            <StatusBarItem>
                <TextBlock Text="] [Net" d:Text="] [Net"
                               VerticalAlignment="Center" Margin="0"/>
            </StatusBarItem>
            <StatusBarItem ToolTip="{Binding NetStatusTooltip}">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextDisabledBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNetConnected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNetConnected}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource IdleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="]" d:Text="]"
                               VerticalAlignment="Center" Margin="0"/>
            </StatusBarItem>
            <Button  Command="{Binding InitializeCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="4,2" VerticalAlignment="Center"
                            ToolTip="{DynamicResource ReloadButtonTooltip}">
                <materialDesign:PackIcon Kind="Reload" Width="16" Height="16"/>
            </Button>
            <!-- StatusBar 右邊區域 -->
            <StatusBarItem HorizontalAlignment="Right">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" d:Text="系統登入人員 使用者"
                        Text="{Binding SystemUser}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" d:Text="xxxx/xx/xx xx:xx"
                        Text="{Binding CurrentTime}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="4"
                            Command="{Binding LoginCommand}"
                            Visibility="{Binding IsLoggedIn, 
                                    Converter={StaticResource BooleanToVisibilityConverter},
                                    ConverterParameter='Invert'}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="4,2" VerticalAlignment="Center"
                            ToolTip="{DynamicResource LogInButtonTooltip}">
                        <materialDesign:PackIcon Kind="Login" Width="16" Height="16"/>
                    </Button>
                    <Button Grid.Column="4"
                            Command="{Binding LogoutCommand}"
                            Visibility="{Binding IsLoggedIn, 
                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="4,2" VerticalAlignment="Center"
                            ToolTip="{DynamicResource LogOutButtonTooltip}">
                        <materialDesign:PackIcon Kind="Logout" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- 主區域(中) -->
        <Grid Margin="0" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <!-- 導覽列 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 主內容 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 導覽列 -->
            <Border Grid.Column="0" Margin="0" d:Width="200"
                    Background="{DynamicResource PrimaryBrush}"
                    Width="{Binding IsCollapsedNav, Converter={StaticResource CollapseWidthConverter}}">
                <DockPanel LastChildFill="True">
                    <!-- 系統設定 釘底 -->
                    <RadioButton DockPanel.Dock="Bottom"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding SwitchModeCommand}"
                                 CommandParameter="{x:Static localvm:NavMode.SystemSettings}"
                                 ToolTip="{DynamicResource SystemSettingsNavButton}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="Cog" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="{DynamicResource SystemSettingsNavButton}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Separator DockPanel.Dock="Bottom"
                               Background="{DynamicResource BorderBrush}"
                               Margin="8,0"/>
                    <!-- 主導覽區 -->
                    <StackPanel Margin="0">
                        <!-- 登入資訊 (待優化) -->
                        <StackPanel Background="{DynamicResource PrimaryDarkBrush}"
                                Orientation="Vertical" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Background="{DynamicResource PrimaryDarkBrush}"
                                                     Foreground="{DynamicResource TextLightBrush}"
                                                     HorizontalAlignment="Center"
                                                     Kind="Account" Margin="0"
                                                     Width="100" Height="100"/>
                            <TextBlock d:Text="訪客" Foreground="{DynamicResource TextLightBrush}"
                                       Text="{Binding CurrentUser.Name}" Margin="5"
                                       FontSize="16" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- 收合按鈕"☰" -->
                        <RadioButton Style="{StaticResource NavButtonStyle}"
                                Command="{Binding CollapseNavCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <materialDesign:PackIcon Kind="Menu" Margin="0,0,5,0"
                                                         Width="30" Height="30"/>
                                <TextBlock VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <!-- 導覽內容 -->
                        <RadioButton GroupName="NavGroup"
                                     Style="{StaticResource NavButtonStyle}"
                                     Command="{Binding SwitchModeCommand}"
                                     CommandParameter="{x:Static localvm:NavMode.Home}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <materialDesign:PackIcon Kind="Home" Margin="0,0,5,0"
                                                         Width="30" Height="30"/>
                                <TextBlock Text="{DynamicResource HomeNavButton}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavGroup"
                                     Style="{StaticResource NavButtonStyle}"
                                     Command="{Binding SwitchModeCommand}"
                                     CommandParameter="{x:Static localvm:NavMode.Operation}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <materialDesign:PackIcon Kind="WrenchCheck" Margin="0,0,5,0"
                                                         Width="30" Height="30"/>
                                <TextBlock Text="{DynamicResource OperationNavButton}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavGroup"
                                     Style="{StaticResource NavButtonStyle}"
                                     Command="{Binding SwitchModeCommand}"
                                     CommandParameter="{x:Static localvm:NavMode.View}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <materialDesign:PackIcon Kind="ChartBox" Margin="0,0,5,0"
                                                         Width="30" Height="30"/>
                                <TextBlock Text="{DynamicResource ViewNavButton}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavGroup"
                                     Style="{StaticResource NavButtonStyle}"
                                     Command="{Binding SwitchModeCommand}"
                                     CommandParameter="{x:Static localvm:NavMode.List}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <materialDesign:PackIcon Kind="ListBox" Margin="0,0,5,0"
                                                         Width="30" Height="30"/>
                                <TextBlock Text="{DynamicResource ListManagementNavButton}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavGroup"
                                     Style="{StaticResource NavButtonStyle}"
                                     Command="{Binding SwitchModeCommand}"
                                     CommandParameter="{x:Static localvm:NavMode.Equipment}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <materialDesign:PackIcon Kind="RobotIndustrial" Margin="0,0,5,0"
                                                         Width="30" Height="30"/>
                                <TextBlock Text="{DynamicResource EquipmentNavButton}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="NavGroup"
                                     Style="{StaticResource NavButtonStyle}"
                                     Command="{Binding SwitchModeCommand}"
                                     CommandParameter="{x:Static localvm:NavMode.Order}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <materialDesign:PackIcon Kind="OrderBoolAscendingVariant" Margin="0,0,5,0"
                                                         Width="30" Height="30"/>
                                <TextBlock Text="{DynamicResource OrderManagementNavButton}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 儀錶板主顯示區 -->
            <Grid x:Name="ContentGrid" Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>
                <!-- 主內容區域：版型由 CurrentLayout 控制 -->
                <Grid Grid.Row="0">
                    <!-- Single（預設） -->
                    <ContentControl Content="{Binding MainCard}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.HorizontalSplit}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.VerticalSplit}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.Quad}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- HorizontalSplit：左右兩格 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.HorizontalSplit}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <localuc:PanelView DataContext="{Binding Panel1}" Grid.Column="0"/>
                        <GridSplitter Grid.Column="1"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}"
                                      ResizeDirection="Columns"/>
                        <localuc:PanelView DataContext="{Binding Panel2}" Grid.Column="2"/>
                    </Grid>

                    <!-- VerticalSplit：上下兩格 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.VerticalSplit}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <localuc:PanelView DataContext="{Binding Panel1}" Grid.Row="0"/>
                        <GridSplitter Grid.Row="1"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}"
                                      ResizeDirection="Rows"/>
                        <localuc:PanelView DataContext="{Binding Panel2}" Grid.Row="2"/>
                    </Grid>

                    <!-- Quad：四格 2×2 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLayout}" Value="{x:Static localvm:LayoutMode.Quad}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <localuc:PanelView DataContext="{Binding Panel1}" Grid.Row="0" Grid.Column="0"/>
                        <localuc:PanelView DataContext="{Binding Panel2}" Grid.Row="0" Grid.Column="2"/>
                        <localuc:PanelView DataContext="{Binding Panel3}" Grid.Row="2" Grid.Column="0"/>
                        <localuc:PanelView DataContext="{Binding Panel4}" Grid.Row="2" Grid.Column="2"/>
                        <GridSplitter Grid.Column="1" Grid.RowSpan="3"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}"
                                      ResizeDirection="Columns"/>
                        <GridSplitter Grid.Row="1" Grid.ColumnSpan="3"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}"
                                      ResizeDirection="Rows"/>
                    </Grid>
                </Grid>
                <!-- GridSplitter -->
                <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Height="5"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderBrush}"/>
                <!-- 狀態訊息區 -->
                <localuc:LogPanel Grid.Row="2" DataContext="{Binding LogPanel}"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
