<Window x:Class="FProductionDashBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:FProductionDashBoard"
        xmlns:localuc="clr-namespace:FProductionDashBoard.UserControls"
        xmlns:localvm="clr-namespace:FProductionDashBoard.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        Title="{Binding AppVersion, StringFormat=ProductionDashBoard -- V{0}}"
        Height="800" Width="1280" Icon="appIcon.ico">
    <!-- window載入事件 -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <!-- 資源匯入 -->
    <Window.Resources>
        <ResourceDictionary>
            <!-- 外部資源 -->
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>

            <!-- 本地資源 -->
            <Storyboard x:Key="CollapseNav">
                <DoubleAnimation Storyboard.TargetProperty="Width"
                             To="50" Duration="0:0:0.3" />
            </Storyboard>
            <Storyboard x:Key="ExpandNav">
                <DoubleAnimation Storyboard.TargetProperty="Width"
                             To="200" Duration="0:0:0.3" />
            </Storyboard>

            <!-- ViewModel 綁定 User Control -->
            <DataTemplate DataType="{x:Type localvm:DeviceCardContainerViewModel}">
                <localuc:DeviceCardContainer />
            </DataTemplate>
            <DataTemplate DataType="{x:Type localvm:SettingViewModel}">
                <localuc:SettingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type localvm:HardwareViewModel}">
                <localuc:HardwareView />
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Menu 區域 -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MaterialDesignPaper}"
              Foreground="{DynamicResource MaterialDesignBody}">
            <MenuItem Header="_檔案">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="File" Width="20" Height="20"/>
                </MenuItem.Icon>
                <MenuItem Header="開啟" InputGestureText="Ctrl+O"/>
                <MenuItem Header="儲存" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="結束"/>
            </MenuItem>

            <MenuItem Header="_編輯">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Edit" Width="20" Height="20"/>
                </MenuItem.Icon>
                <MenuItem Header="剪下"/>
                <MenuItem Header="複製"/>
                <MenuItem Header="貼上"/>
            </MenuItem>
        </Menu>

        <!-- ToolBar 區域 -->
        <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource PrimaryBackgroundBrush}">
            <ToolBar Background="{DynamicResource PrimaryBackgroundBrush}">
                <Button ToolTip="新增" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="Add" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="開啟" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="儲存" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                </Button>
                <Separator/>
                <Button ToolTip="剪下" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="ContentCut" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="複製" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20"/>
                </Button>
                <Button ToolTip="貼上" Foreground="{DynamicResource TextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="ContentPaste" Width="20" Height="20"/>
                </Button>
                <Separator/>
                <Button ToolTip="測試" Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding TestCommand}">
                    <materialDesign:PackIcon Kind="AbTesting" Width="20" Height="20"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- StatusBar 區域 -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource MaterialDesignPaper}"
                   Foreground="{DynamicResource MaterialDesignBody}">
            <!-- 進度條訊息 -->
            <StatusBarItem>
                <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Width="120" Height="10" Margin="5,0"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                             VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ProgressString}" d:Text="Idle"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
            </StatusBarItem>
            <!-- 讀卡機狀態 -->
            <StatusBarItem>
                <TextBlock Text="[Reader" d:Text="[Reader"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StatusBarItem>
            <StatusBarItem ToolTip="{Binding CardReaderStatusTooltip}">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextDisabledBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardReaderConnected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCardReaderConnected}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource IdleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StatusBarItem>
            <!-- 網路連線狀態 -->
            <StatusBarItem>
                <TextBlock Text="] [Net" d:Text="] [Net"
                               VerticalAlignment="Center" Margin="0"/>
            </StatusBarItem>
            <StatusBarItem ToolTip="{Binding NetStatusTooltip}">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextDisabledBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNetConnected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNetConnected}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource IdleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="]" d:Text="]"
                               VerticalAlignment="Center" Margin="0"/>
            </StatusBarItem>
            <Button  Command="{Binding InitializeCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="4,2" VerticalAlignment="Center"
                            ToolTip="{DynamicResource ReloadButtonTooltip}">
                <materialDesign:PackIcon Kind="Reload" Width="16" Height="16"/>
            </Button>
            <!-- StatusBar 右邊區域 -->
            <StatusBarItem HorizontalAlignment="Right">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" d:Text="系統登入人員 使用者"
                        Text="{Binding SystemUser}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" d:Text="xxxx/xx/xx xx:xx"
                        Text="{Binding CurrentTime}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="4"
                            Command="{Binding LoginCommand}"
                            Visibility="{Binding IsLoggedIn, 
                                    Converter={StaticResource BooleanToVisibilityConverter},
                                    ConverterParameter='Invert'}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="4,2" VerticalAlignment="Center"
                            ToolTip="{DynamicResource LogInButtonTooltip}">
                        <materialDesign:PackIcon Kind="Login" Width="16" Height="16"/>
                    </Button>
                    <Button Grid.Column="4"
                            Command="{Binding LogoutCommand}"
                            Visibility="{Binding IsLoggedIn, 
                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="4,2" VerticalAlignment="Center"
                            ToolTip="{DynamicResource LogOutButtonTooltip}">
                        <materialDesign:PackIcon Kind="Logout" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- 主區域(中) -->
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <!-- 導覽列 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 主內容 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 導覽列 -->
            <Border Grid.Column="0" Margin="0" d:Width="200"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    Width="{Binding IsCollapsedNav, Converter={StaticResource CollapseWidthConverter}}">
                <StackPanel Margin="0">
                    <!-- 登入資訊 (待優化) -->
                    <StackPanel Background="{DynamicResource PrimaryBrush}"
                            Orientation="Vertical" HorizontalAlignment="Stretch">
                        <materialDesign:PackIcon Background="{DynamicResource PrimaryBrush}"
                                                 Foreground="{DynamicResource TextLightBrush}"
                                                 HorizontalAlignment="Center"
                                                 Kind="Account" Margin="0"
                                                 Width="100" Height="100"/>
                        <TextBlock d:Text="訪客" Foreground="{DynamicResource TextLightBrush}" 
                                   Text="{Binding CurrentUser.Name}" Margin="5"
                                   FontSize="16" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <!-- 收合按鈕"☰" -->
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                            Command="{Binding CollapseNavCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="Menu" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- 導覽內容 -->
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding SwitchModeCommand}" 
                                 CommandParameter="{x:Static localvm:NavMode.Home}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="Home" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="{DynamicResource HomeNavButton}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding SwitchModeCommand}" 
                                 CommandParameter="{x:Static localvm:NavMode.Operation}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="WrenchCheck" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="{DynamicResource OperationNavButton}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding SwitchModeCommand}" 
                                 CommandParameter="{x:Static localvm:NavMode.View}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="ChartBox" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="{DynamicResource ViewNavButton}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding SwitchModeCommand}" 
                                 CommandParameter="{x:Static localvm:NavMode.List}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="ListBox" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="{DynamicResource ListManagementNavButton}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding SwitchModeCommand}" 
                                 CommandParameter="{x:Static localvm:NavMode.Equipment}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="RobotIndustrial" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="{DynamicResource EquipmentNavButton}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding SwitchModeCommand}" 
                                 CommandParameter="{x:Static localvm:NavMode.Order}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <materialDesign:PackIcon Kind="OrderBoolAscendingVariant" Margin="0,0,5,0"
                                                     Width="30" Height="30"/>
                            <TextBlock Text="{DynamicResource OrderManagementNavButton}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- 加入:系統設定(主題、語言、預設參數) -->
                </StackPanel>
            </Border>

            <!-- 儀錶板主顯示區 -->
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>
                <!-- 主內容UI (預設2欄儀表板卡片) ScrollViewer/WrapPanel -->
                <Grid Grid.Row="0">
                    <!-- 後續定義分割區塊 -->
                    <!--<ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type localvm:DeviceCardContainerViewModel}">
                                <localuc:DeviceCardContainer />
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>-->
                    <!-- 使用者自訂卡片區塊 -->
                    <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding MainCard}" />

                </Grid>
                <!-- GridSplitter -->
                <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Height="5"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource BorderBrush}"/>
                <!-- 狀態訊息區 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Margin="5" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <!-- 訊息視窗 -->
                        <ListBox Grid.Column="0" x:Name="LogListBox"
                                 Background="{DynamicResource BackgroundBrush}"
                                 ItemsSource="{Binding CurrentLogs}"
                                 local:ListBoxBehavior.AutoScrollToEnd="{Binding AutoScrollEnabled}">
                            <!-- 行高/內距/文字大小/行距 -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="FontWeight"  Value="Semibold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsLargeFontMode, 
                                            RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            Value="True">
                                            <Setter Property="Height" Value="32" />
                                            <Setter Property="FontSize" Value="15" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <!-- 時間StringFormat={}[{0:HH:mm:ss}] -->
                                        <TextBlock Margin="0,0,5,0" Foreground="{Binding Color}"
                                            Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}"/>
                                        <!-- 圖示 (PackIconKind enum 綁定) -->
                                        <materialDesign:PackIcon Kind="{Binding Icon}" 
                                         Foreground="{Binding Color}" VerticalAlignment="Center"
                                         Width="14" Height="14" Margin="0,0,5,0"/>
                                        <!-- 訊息 -->
                                        <TextBlock Margin="0,0,5,0" Foreground="{Binding Color}"
                                                   Style="{StaticResource EllipsisTextBlock}"
                                                   Text="{Binding Message}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 訊息視窗操作介面 -->
                        <StackPanel Grid.Column="1" Margin="2" HorizontalAlignment="Center">
                            <ToggleButton Width="25" Height="25" Margin="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FunctionToggleButtonStyle}"
                                    IsChecked="{Binding AutoScrollEnabled}"
                                    ToolTip="{DynamicResource PinButtonTooltip}">
                                <materialDesign:PackIcon Kind="Pin"
                                                     Width="25" Height="25"/>
                            </ToggleButton>
                            <ToggleButton Width="25" Height="25" Margin="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FunctionToggleButtonStyle}"
                                    IsChecked="{Binding IsErrorMode}"
                                    ToolTip="{DynamicResource ErrorLogButtonTooltip}">
                                <materialDesign:PackIcon Kind="{Binding _log.IsNewErrorLog, 
                                            Converter={StaticResource BoolToAlertConverter}}"
                                                     Width="23" Height="23"/>
                            </ToggleButton>
                            <ToggleButton Width="25" Height="25" Margin="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FunctionToggleButtonStyle}"
                                    IsChecked="{Binding IsLargeFontMode}"
                                    ToolTip="{DynamicResource LargeFontButtonTooltip}">
                                <materialDesign:PackIcon Kind="AlphaBCircleOutline"
                                                     Width="25" Height="25"/>
                            </ToggleButton>
                            <Button Width="25" Height="25" Margin="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FunctionButtonStyle}"
                                    Command="{Binding SaveLogsCommand}"
                                    ToolTip="{DynamicResource LogSaveButtonTooltip}">
                                <materialDesign:PackIcon Kind="DownloadCircleOutline"
                                                     Width="25" Height="25"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
