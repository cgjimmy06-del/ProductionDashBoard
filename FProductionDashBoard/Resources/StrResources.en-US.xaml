<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!--#region login window -->
    <sys:String x:Key="LanguageText">Language</sys:String>
    <sys:String x:Key="ServerText">Server</sys:String>
    <sys:String x:Key="AccountText">Account (Staff Number)</sys:String>
    <sys:String x:Key="PasswordText">Password</sys:String>
    <sys:String x:Key="RequiredText">Required</sys:String>
    <sys:String x:Key="RememberMeCheck">Remember Me</sys:String>
    <sys:String x:Key="LoginButton">Log In</sys:String>
    <sys:String x:Key="VisitorButton">Visitor</sys:String>
    <!--#endregion-->
    <!--#region dialog window -->
    <sys:String x:Key="ConfirmButton">Confirm</sys:String>
    <sys:String x:Key="CancelButton">Cancel</sys:String>
    <!--#endregion-->
    <!--#region inspection dialog -->
    <sys:String x:Key="NormalRadioButton">Pass</sys:String>
    <sys:String x:Key="IssueRadioButton">Report Issue</sys:String>
    <!--#endregion-->
    <!--#region device card -->
    <sys:String x:Key="MetarialChangeButton">Metarial</sys:String>
    <sys:String x:Key="FirstInspectionButton">First Ins.</sys:String>
    <sys:String x:Key="RoutineInspectionButton">Routine Ins.</sys:String>
    <sys:String x:Key="OperationButton">Operation</sys:String>
    <!--#endregion-->

</ResourceDictionary>