<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!--#region login window 登入視窗 -->
    <sys:String x:Key="LanguageText">語言</sys:String>
    <sys:String x:Key="ServerText">伺服器</sys:String>
    <sys:String x:Key="AccountText">帳號 (職號)</sys:String>
    <sys:String x:Key="PasswordText">密碼</sys:String>
    <sys:String x:Key="RequiredText">必填</sys:String>
    <sys:String x:Key="RememberMeCheck">記住我</sys:String>
    <sys:String x:Key="LoginButton">登入</sys:String>
    <sys:String x:Key="VisitorButton">訪客</sys:String>
    <!--#endregion-->
    <!--#region Main Window 主視窗 (含導覽列/訊息視窗) -->
    <sys:String x:Key="PinButtonTooltip">釘選訊息至最新</sys:String>
    <sys:String x:Key="ErrorLogButtonTooltip">切換至錯誤訊息視窗</sys:String>
    <sys:String x:Key="LargeFontButtonTooltip">放大字體</sys:String>
    <sys:String x:Key="LogSaveButtonTooltip">儲存當前訊息紀錄(含異常)</sys:String>
    <!--#endregion-->
    <!--#region device card block 設備卡片操作區 -->
    <sys:String x:Key="AddDeviceButtonTooltip">新增設備卡片</sys:String>
    <sys:String x:Key="FastUploadButtonTooltip">快速上載設備卡片預設清單</sys:String>
    <sys:String x:Key="FastDownloadButtonTooltip">快速儲存設備卡片清單</sys:String>
    <!--#endregion-->
    <!--#region device card 設備卡片 -->
    <sys:String x:Key="MetarialChangeButton">物料</sys:String>
    <sys:String x:Key="FirstInspectionButton">首件</sys:String>
    <sys:String x:Key="RoutineInspectionButton">巡檢</sys:String>
    <sys:String x:Key="OperationButton">調試</sys:String>
    <!--#endregion-->
    <!--#region dialog window 彈出視窗 -->
    <sys:String x:Key="ConfirmButton">確認</sys:String>
    <sys:String x:Key="CancelButton">取消</sys:String>
    <!--#endregion-->
    <!--#region inspection dialog 檢驗視窗 -->
    <sys:String x:Key="NormalRadioButton">正常</sys:String>
    <sys:String x:Key="IssueRadioButton">異常回報</sys:String>
    <!--#endregion-->
    <!--#region material change dialog 物料視窗 -->
    <sys:String x:Key="ModeChangeButton">模式切換</sys:String>
    <sys:String x:Key="ClearSelectionButton">清除</sys:String>
    <!--#endregion-->
    <!--#region common datagrid header 欄位抬頭共用字串 -->
    <sys:String x:Key="DeivceIdDataGridHeader">設備ID</sys:String>
    <sys:String x:Key="NameDataGridHeader">名稱</sys:String>
    <sys:String x:Key="IpDataGridHeader">IP</sys:String>
    <sys:String x:Key="LoadedDataGridHeader">已載入</sys:String>
    <!--#endregion-->
    <!--#region dcard manage dialog 設備卡片新增視窗 -->
    <sys:String x:Key="AddToSelectedButtonTooltip">新增所選之設備至已載入清單</sys:String>
    <sys:String x:Key="RemoveSelectedButtonTooltip">移除已載入清單中所選之設備</sys:String>
    <sys:String x:Key="UploadButtonTooltip">上載清單至已載入</sys:String>
    <sys:String x:Key="DownloadButtonTooltip">儲存清單到檔案</sys:String>
    <!--#endregion-->
    
    
</ResourceDictionary>