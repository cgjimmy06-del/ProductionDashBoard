<Window x:Class="FProductionDashBoard.SubWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FProductionDashBoard"
        mc:Ignorable="d"
        Title="SubWindow1" Height="250" Width="400"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <TextBox Text="{Binding Name}"/>
        <TextBlock Text="輸入設備名稱"
               Foreground="Gray"
               IsHitTestVisible="False"
               Margin="5,0,0,0"
               VerticalAlignment="Center"
               Visibility="{Binding Name, Converter={StaticResource PlaceholderConverter}}" />
        <TextBox Text="{Binding Description}"/>
        <TextBlock Text="輸入描述"
               Foreground="Gray"
               IsHitTestVisible="False"
               Margin="5,0,0,0"
               VerticalAlignment="Center"
               Visibility="{Binding Name, Converter={StaticResource PlaceholderConverter}}" />
        <!--<CheckBox Content="燈號預設開啟" IsChecked="{Binding LightOn}" />-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="確認" Command="{Binding ConfirmCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="取消" Command="{Binding CancelCommand}" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
