        </Style.Triggers>
    </Style>
    <Style x:Key="PioCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduleStatus.Pending}">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ScheduleStatus.Scheduled}">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- 左右滑動開關（功能啟閉用），統一收斂 MaterialDesign Switch 引用點 -->
