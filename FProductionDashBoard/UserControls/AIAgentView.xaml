<UserControl x:Class="FProductionDashBoard.UserControls.AIAgentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:uimodel="clr-namespace:FProductionDashBoard.UiModels">

    <UserControl.Resources>
        <!-- ChatMessage DataTemplate -->
        <DataTemplate DataType="{x:Type uimodel:ChatMessage}">
            <Border Margin="4,3" Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Sender}" Value="User">
                                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="6,2,2,2">
                    <!-- 發話者 + 時間 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource AiSenderAi}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sender}" Value="User">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                                            <Setter Property="Text" Value="{DynamicResource AiSenderYou}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Time, StringFormat=HH:mm}"
                                   FontSize="10" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 內容 / Typing 動畫（User 與思考中訊息用；AI 完成訊息改由下方 Markdown 檢視器顯示） -->
                    <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Content}"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTyping}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource AiThinking}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Sender}" Value="Ai"/>
                                            <Condition Binding="{Binding IsTyping}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- AI 完成訊息的 Markdown 渲染（Document 只在 trigger 內綁定，User/思考中訊息不觸發解析） -->
                    <FlowDocumentScrollViewer Margin="0,2,0,0"
                                              Padding="0"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Zoom="100" MinZoom="100" MaxZoom="100"
                                              PreviewMouseWheel="MarkdownViewer_PreviewMouseWheel"
                                              PreviewMouseLeftButtonDown="MarkdownViewer_PreviewMouseLeftButtonDown">
                        <FlowDocumentScrollViewer.Style>
                            <Style TargetType="FlowDocumentScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Sender}" Value="Ai"/>
                                            <Condition Binding="{Binding IsTyping}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Document" Value="{Binding Content, Converter={StaticResource AiMarkdownToDocumentConverter}}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </FlowDocumentScrollViewer.Style>
                    </FlowDocumentScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ChatSession DataTemplate（歷史清單用） -->
        <DataTemplate DataType="{x:Type uimodel:ChatSession}">
            <Border Margin="4,2" Padding="8,6"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    CornerRadius="4" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding LastTime, StringFormat=MM/dd HH:mm}"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ModelUsed}" Margin="6,0,0,0"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                            Width="14" Height="14">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="StarOutline"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStarred}" Value="True">
                                        <Setter Property="Kind" Value="Star"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Header + 模型 + Chip -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: ConfigWarning 提示條 -->
            <RowDefinition Height="*"/>     <!-- Row 2: 訊息清單 -->
            <RowDefinition Height="Auto"/>  <!-- Row 3: 輸入區 -->
        </Grid.RowDefinitions>

        <!-- ========== Row 0: Header ========== -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel Margin="6,4">
                <!-- 標題列 -->
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Robot" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryBrush}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AiAgentTitle}" FontWeight="SemiBold" FontSize="16" Margin="5,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding NewSessionCommand}"
                                ToolTip="{DynamicResource AiNewChat}" Padding="4" Height="28" Width="28">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="20" Height="20"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <ToggleButton Style="{StaticResource FunctionToggleButtonStyle}"
                                      IsChecked="{Binding IsHistoryVisible}"
                                      ToolTip="{DynamicResource AiHistory}" Height="28" Width="28" Margin="4,0">
                            <materialDesign:PackIcon Kind="History" Width="20" Height="20"/>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
                <!-- 模型選擇 -->
                <ComboBox ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel}"
                          Margin="0,4,0,2" FontSize="13"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <!-- 模式 Chip -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="0,2,0,0">
                    <ItemsControl ItemsSource="{Binding AvailableModes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,4,0" Padding="8,2" Height="22"
                                        Command="{Binding DataContext.SelectModeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Converter={StaticResource AiAgentModeToLabelConverter}}"
                                               FontSize="12"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                                                            <Binding Path="DataContext.SelectedMode"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ========== Row 1: ConfigWarning 提示條 ========== -->
        <Border Grid.Row="1" Background="{DynamicResource WarningBrush}" Padding="8,4"
                Visibility="{Binding ConfigWarning, Converter={StaticResource StringHasValueToVisibilityConverter}}">
            <TextBlock Text="{Binding ConfigWarning}"
                       Foreground="{DynamicResource TextDarkBrush}" FontSize="12"/>
        </Border>
        
        <!-- ========== Row 2: 訊息清單 ========== -->
        <ScrollViewer x:Name="MessageScrollViewer" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="MessageList"
                          ItemsSource="{Binding CurrentSession.Messages}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,4"/>
        </ScrollViewer>

        <!-- ========== Row 3: 輸入區 ========== -->
        <Border Grid.Row="3" Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}"
                Padding="6,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="False" TextWrapping="Wrap"
                         MaxHeight="80" VerticalScrollBarVisibility="Auto"
                         FontSize="12" Padding="6,4"
                         materialDesign:HintAssist.Hint="{DynamicResource AiInputHint}"
                         Foreground="{DynamicResource TextPrimaryBrush}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Margin="6,0,0,0"
                        Command="{Binding SendCommand}"
                        Width="36" Height="36" Padding="0"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="{DynamicResource TextLightBrush}"
                        ToolTip="{DynamicResource AiSend}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTyping}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon Kind="Send" Width="18" Height="18"/>
                </Button>
                <Button Grid.Column="1" Margin="6,0,0,0"
                        Command="{Binding CancelCommand}"
                        Width="36" Height="36" Padding="0"
                        Background="{DynamicResource ErrorBrush}"
                        Foreground="{DynamicResource TextLightBrush}"
                        ToolTip="{DynamicResource AiCancelTooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTyping}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon Kind="Stop" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ========== 歷史側欄 Overlay ========== -->
        <Grid Grid.RowSpan="4" Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHistoryVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid Background="{DynamicResource BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 標題列 -->
                    <RowDefinition Height="Auto"/>   <!-- 搜尋 -->
                    <RowDefinition Height="Auto"/>   <!-- 分類 Filter -->
                    <RowDefinition Height="*"/>      <!-- 清單 -->
                </Grid.RowDefinitions>

                <!-- 標題列 -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryBackgroundBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                        Padding="8,6">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding ToggleHistoryCommand}"
                                Padding="4" Height="28" Width="28">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <TextBlock Text="{DynamicResource AiHistory}" FontWeight="SemiBold" FontSize="13" Margin="4,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding NewSessionCommand}"
                                ToolTip="新對話" Padding="4" Height="28" Width="28">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- 搜尋 -->
                <TextBox Grid.Row="1" Margin="8,6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="12"
                         materialDesign:HintAssist.Hint="{DynamicResource AiSearchHint}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- 歷史篩選 Chip -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="8,0,8,6">
                    <ItemsControl ItemsSource="{Binding HistoryFilterOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,4,0" Padding="8,2" Height="22"
                                        Command="{Binding DataContext.SelectHistoryFilterCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Converter={StaticResource AiAgentModeToLabelConverter}}"
                                               FontSize="12"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource StringEqualityMultiConverter}">
                                                            <Binding Path="DataContext.SelectedHistoryFilter"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 歷史清單 -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredSessions}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type uimodel:ChatSession}">
                                <Border Margin="6,3" Padding="8,6"
                                        Background="{DynamicResource PrimaryBackgroundBrush}"
                                        CornerRadius="4" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.LoadSessionCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding LastTime, StringFormat=MM/dd HH:mm}"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ModelUsed}" Margin="6,0,0,0"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding DataContext.ToggleStarCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="2" Width="24" Height="24">
                                            <materialDesign:PackIcon Width="14" Height="14">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="StarOutline"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStarred}" Value="True">
                                                                <Setter Property="Kind" Value="Star"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
