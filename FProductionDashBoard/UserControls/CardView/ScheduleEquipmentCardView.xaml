<UserControl x:Class="FProductionDashBoard.UserControls.ScheduleEquipmentCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localvm="clr-namespace:FProductionDashBoard.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="180">

    <Border Width="170" CornerRadius="8"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderThickness="2" Padding="8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Opacity" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CardColor}" Value="{x:Static localvm:ScheduleCardColor.Green}">
                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CardColor}" Value="{x:Static localvm:ScheduleCardColor.Orange}">
                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CardColor}" Value="{x:Static localvm:ScheduleCardColor.Blue}">
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CardColor}" Value="{x:Static localvm:ScheduleCardColor.Gray}">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="Opacity" Value="0.5"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
        </Border.Effect>

        <StackPanel>

            <!-- 標題：設備名稱 + 右上色碼點 -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="{Binding Name}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Ellipse Width="10" Height="10"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Fill="{Binding CardColor, Converter={StaticResource ScheduleCardColorToBrushConverter}}"/>
            </Grid>

            <!-- 設備 Code -->
            <TextBlock Text="{Binding Code}"
                       FontSize="11" Opacity="0.6"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>

            <!-- 接單資訊 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource SchCardOrders}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,4,0"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="{Binding ActiveOrderCount, Mode=OneWay}"/><Run Text=" 筆 / "/>
                    <Run Text="{Binding TotalPendingQty, Mode=OneWay}"/><Run Text=" 件"/>
                </TextBlock>
            </StackPanel>

            <!-- Chip 區 -->
            <WrapPanel Margin="0,0,0,4">
                <!-- 調試中 chip -->
                <Border CornerRadius="6" Padding="6,2" Margin="0,0,4,2"
                        Background="{DynamicResource WarningBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTuning}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{DynamicResource SchCardTuningLabel}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDarkBrush}"/>
                </Border>

                <!-- 負載 chip（橘/藍卡才顯示，即 TotalPendingQty > 0） -->
                <Border CornerRadius="6" Padding="6,2" Margin="0,0,0,2"
                        Background="{DynamicResource SecondaryBackgroundBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LoadLevel}" Value="{x:Static localvm:ScheduleCardLoadLevel.None}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LoadLevel, Converter={StaticResource ScheduleCardLoadLevelToLabelConverter}}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </WrapPanel>

            <!-- InProductionInfo（有接單進行中才顯示） -->
            <TextBlock Text="{Binding InProductionInfo}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                       Visibility="{Binding InProductionInfo,
                                   Converter={StaticResource StringHasValueToVisibilityConverter}}"/>

            <!-- 程式資訊：可生產 F / 總計 N -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource SchCardPrograms}"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,4,0"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="{Binding FeasibleMatchingCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7">
                    <Run Text=" ("/>
                    <Run Text="{Binding TotalMatchingCount, Mode=OneWay}"/>
                    <Run Text=")"/>
                </TextBlock>
                <TextBlock Text=" / "
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7">
                    <Run Text="{Binding TotalProgramCount, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <!-- 指派按鈕（Commit 4 啟用） -->
            <Button Content="{DynamicResource SchAssignButton}"
                    Style="{DynamicResource FunctionButtonStyle}"
                    Background="{DynamicResource PrimaryBrush}"
                    Padding="8,4" Height="Auto"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"/>

        </StackPanel>
    </Border>
</UserControl>
