<UserControl x:Class="FProductionDashBoard.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FProductionDashBoard"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5">
        <StackPanel>
            <!-- 標題區 -->
            <TextBlock Text="{Binding Info.Name}" FontWeight="Bold"/>
            <!-- 描述區 -->
            <TextBlock Text="{Binding Info.Description}" FontStyle="Italic"/>
            <TextBlock Text="{Binding ButtonClickCount, StringFormat=點擊次數: {0}}"/>
            <!-- 控制區 -->
            <StackPanel Orientation="Horizontal" >
                <Button Content="設備按鈕" Command="{Binding ButtonClickCommand}" 
                        Background="#4CAF50" Foreground="White" Padding="5,2"/>
                <Button Content="切換燈號" Command="{Binding ToggleLightCommand}" 
                        Background="#2196F3" Foreground="White" Padding="5,2"/>
            </StackPanel>
            <!-- 狀態顯示 -->
            <TextBlock Text="{Binding Info.LightOn, StringFormat=燈號狀態: {0}}" 
                       FontSize="12" Foreground="{Binding Info.LightOn, Converter={StaticResource BoolToColorConverter}}" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
