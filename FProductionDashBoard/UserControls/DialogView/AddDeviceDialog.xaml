<UserControl x:Class="FProductionDashBoard.UserControls.AddDeviceDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:FProductionDashBoard"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:Background="White"
             d:DesignHeight="500" d:DesignWidth="600">
    <Grid Width="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 第一排：類型 + 棟別 ComboBox -->
        <Grid Grid.Row="0" Margin="10,6,10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Margin="0,0,4,0"
                      ItemsSource="{Binding TypeFilterOptions}"
                      SelectedValue="{Binding TypeFilter}"
                      SelectedValuePath="Value"
                      materialDesign:HintAssist.Hint="{DynamicResource EqprodFilterType}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Value.Name}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{DynamicResource EqprodTypeFilterAll}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1" Margin="4,0,0,0"
                      ItemsSource="{Binding BuildingOptions}"
                      SelectedItem="{Binding BuildingFilter}"
                      materialDesign:HintAssist.Hint="{DynamicResource AddDeviceFilterBuilding}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="">
                                            <Setter Property="Text" Value="{DynamicResource AddDeviceFilterBuildingAll}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- 第二排：模糊 Keyword TextBox -->
        <TextBox Grid.Row="1" Margin="10,2,10,6"
                 materialDesign:HintAssist.Hint="{DynamicResource AddDeviceFilterKeyword}"
                 Text="{Binding KeywordFilter, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="2" Margin="5,0" Height="300" Orientation="Horizontal">
            <!-- 篩選清單 -->
            <DataGrid ItemsSource="{Binding FilteredDevices}"
                      local:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedFromFiltered}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>
                <i:Interaction.Triggers>
                    <!-- 雙擊加入 -->
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding AddToSelectedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource DeivceIdDataGridHeader}" 
                                        Width="100" Binding="{Binding DeviceID}"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource NameDataGridHeader}" 
                                        Width="100" Binding="{Binding Name}"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource IpDataGridHeader}" 
                                        Width="100" Binding="{Binding IP}"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- 增減操作 -->
            <StackPanel VerticalAlignment="Center">
                <Button Margin="5" Height="40" Width="40" Padding="2"
                        Command="{Binding AddToSelectedCommand}" 
                        ToolTip="{DynamicResource AddToSelectedButtonTooltip}">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight"
                                                 Width="30" Height="30"/>
                </Button>
                <Button Margin="5" Height="40" Width="40" Padding="2"
                        Command="{Binding RemoveFromSelectedCommand}"
                        ToolTip="{DynamicResource RemoveSelectedButtonTooltip}">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft"
                                                 Width="30" Height="30"/>
                </Button>
            </StackPanel>
            <!-- 選擇清單 -->
            <DataGrid ItemsSource="{Binding SelectedDevices}"
                      local:DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedFromSelected}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>
                <i:Interaction.Triggers>
                    <!-- 雙擊加入 -->
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding RemoveFromSelectedCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource LoadedDataGridHeader}" 
                                        Width="100" Binding="{Binding Name}"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- 上下載操作 -->
            <StackPanel VerticalAlignment="Center">
                <Button Margin="5" Height="40" Width="40" Padding="2"
                        Command="{Binding UploadDevicesCommand}"
                        ToolTip="{DynamicResource UploadButtonTooltip}">
                    <materialDesign:PackIcon Kind="FileUpload"
                                             Width="30" Height="30"/>
                </Button>
                <Button Margin="5" Height="40" Width="40" Padding="2"
                        Command="{Binding DownloadDevicesCommand}"
                        ToolTip="{DynamicResource DownloadButtonTooltip}">
                    <materialDesign:PackIcon Kind="FileDownload"
                                             Width="30" Height="30"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
