<UserControl x:Class="FProductionDashBoard.UserControls.DialogView.MesSyncDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:uimodels="clr-namespace:FProductionDashBoard.UiModels"
             mc:Ignorable="d"
             Width="820" d:DesignHeight="480" d:DesignWidth="820" d:Background="White">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MaxHeight="380"/>
        </Grid.RowDefinitions>

        <!-- 篩選列 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <CheckBox Content="{DynamicResource MesSyncDialog_OnlyUnsynced}"
                      IsChecked="{Binding OnlyUnsynced}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"/>

            <ComboBox ItemsSource="{Binding GroupOptions}"
                      SelectedItem="{Binding GroupFilter}"
                      Width="120"
                      Margin="0,0,12,0"
                      materialDesign:HintAssist.Hint="{DynamicResource MesSyncDialog_GroupHint}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="">
                                            <Setter Property="Text" Value="{DynamicResource MesSyncDialog_AllGroups}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="{DynamicResource MesSyncDialog_SelectAll}"
                    Command="{Binding SelectAllCommand}"
                    Style="{StaticResource FunctionButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource MesSyncDialog_ClearAll}"
                    Command="{Binding ClearAllCommand}"
                    Style="{StaticResource FunctionButtonStyle}"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
            <DataGrid.Columns>

                <!-- 勾選 -->
                <DataGridTemplateColumn Width="38">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      IsEnabled="{Binding IsEnabled}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="Auto"
                                    ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                <DataGridTextColumn Header="{DynamicResource SettingNameDataGridHeader}" Binding="{Binding Name}" Width="*"
                                    ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="150"
                                    ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="80"
                                    ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                <!-- 狀態欄 -->
                <DataGridTemplateColumn Header="{DynamicResource MesSyncDialog_StatusHeader}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="{DynamicResource MesSyncState_MesOnly}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncState}" Value="{x:Static uimodels:MesSyncState.Synced}">
                                                <Setter Property="Text"       Value="{DynamicResource MesSyncState_Synced}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncState}" Value="{x:Static uimodels:MesSyncState.LocalOnly}">
                                                <Setter Property="Text" Value="{DynamicResource MesSyncState_LocalOnly}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncState}" Value="{x:Static uimodels:MesSyncState.DataMismatch}">
                                                <Setter Property="Text"       Value="{DynamicResource MesSyncState_DataMismatch}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
