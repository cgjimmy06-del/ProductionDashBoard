<UserControl x:Class="FProductionDashBoard.UserControls.ProgramStatusDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FProductionDashBoard"
             xmlns:models="clr-namespace:FProductionDashBoard.Models"
             mc:Ignorable="d" Width="360" Height="Auto"
             d:DesignHeight="260" d:DesignWidth="360" d:Background="White">

    <UserControl.Resources>
        <local:TuningTypeToBrushConverter x:Key="TuningTypeToBrushConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="16,5">
        <!-- 程式資訊 -->
        <TextBlock Text="{Binding PartNo}"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,4"
                   d:Text="ABC-2048"/>
        <TextBlock Text="{Binding Detail}"
                   FontSize="16" Opacity="0.65"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,20"
                   TextTrimming="CharacterEllipsis"
                   d:Text="BrandX · ModelY · Process1"/>

        <!-- 狀態選擇 Grid：Row0 = 可生產/待審核/不可生產；Row1 = 帶點/調品質 -->
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="1" Margin="0,4">
                <!-- Row 0: 可生產 -->
                <Button Margin="8,4" Width="90"
                    Visibility="{Binding FeasibleVisibility}"
                    Command="{Binding SelectFeasibleCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatus}"
                                         Value="{x:Static models:TuningType.Feasible}">
                                    <Setter Property="Background" Value="{DynamicResource ProgramFeasibleBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{DynamicResource PlStatFeasible}"/>
                </Button>

                <!-- Row 0: 待審核 -->
                <Button Margin="8,4"  Width="90"
                    Visibility="{Binding PendingVisibility}"
                    Command="{Binding SelectPendingCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatus}"
                                         Value="{x:Static models:TuningType.Pending}">
                                    <Setter Property="Background" Value="{DynamicResource ProgramPendingBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{DynamicResource PlStatPending}"/>
                </Button>

                <!-- Row 0: 不可生產 -->
                <Button Margin="8,4"  Width="90"
                    Visibility="{Binding InfeasibleVisibility}"
                    Command="{Binding SelectInfeasibleCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatus}"
                                         Value="{x:Static models:TuningType.Infeasible}">
                                    <Setter Property="Background" Value="{DynamicResource ProgramErrorBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{DynamicResource PlStatInfeasible}"/>
                </Button>
            </WrapPanel>

            <WrapPanel Grid.Row="3" Margin="0,4">
                <!-- Row 1: 帶點 -->
                <Button Margin="8,4"  Width="90"
                    Visibility="{Binding TeachingVisibility}"
                    Command="{Binding SelectTeachingCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatus}"
                                         Value="{x:Static models:TuningType.Teaching}">
                                    <Setter Property="Background" Value="{DynamicResource ProgramErrorBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{DynamicResource PlStatTeaching}"/>
                </Button>

                <!-- Row 1: 調品質 -->
                <Button Margin="8,4"  Width="90"
                    Visibility="{Binding OffsetVisibility}"
                    Command="{Binding SelectOffsetCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatus}"
                                         Value="{x:Static models:TuningType.Offset}">
                                    <Setter Property="Background" Value="{DynamicResource ProgramErrorBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{DynamicResource PlStatOffset}"/>
                </Button>
            </WrapPanel>
        </Grid>
    </StackPanel>
</UserControl>
