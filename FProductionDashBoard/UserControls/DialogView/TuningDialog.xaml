<UserControl x:Class="FProductionDashBoard.UserControls.TuningDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" Height="Auto" Width="400"
             d:DesignHeight="400" d:DesignWidth="400" d:Background="White">

    <StackPanel Margin="20,5">
        <!-- 當前操作資訊 -->
        <TextBlock Margin="0,0,0,10" d:Text="機台"
                   Text="{Binding CurrentDevice}"/>
        <TextBlock Margin="0,0,0,10" d:Text="操作人員"
                   Text="{Binding CurrentUser}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource TuningLastTeachedByLabel}"/>
            <TextBlock Text=" : "/>
            <TextBlock Text="{Binding TeachedUserName}" FontWeight="SemiBold" d:Text="—"/>
        </StackPanel>

        <!-- 執行人員 -->
        <TextBlock Margin="0,0,0,4" Text="{DynamicResource TuningExecutorLabel}"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding FilteredEmployees}"
                      SelectedItem="{Binding SelectedEmployee}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UserId}"/>
                            <TextBlock Text=" - "/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="1" Width="130" Margin="8,0,0,0"
                     VerticalAlignment="Bottom"
                     materialDesign:HintAssist.Hint="{DynamicResource TuningEmployeeFilterHint}"
                     Text="{Binding EmployeeFilterText, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- 選擇按鈕 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,0,0,10" Height="40">
            <Button Content="{DynamicResource TuningTeachingButton}"
                    Command="{Binding TeachingCommand}"
                    Margin="20,0" Width="100">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TuningMode}" Value="1">
                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{DynamicResource TuningOffsetButton}"
                    Command="{Binding OffsetCommand}"
                    Margin="20,0" Width="100">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TuningMode}" Value="2">
                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- 強制安排（僅 Setting 權限可見；反色＝開啟） -->
            <Button Content="{DynamicResource TuningForceArrangeToggle}"
                    Command="{Binding ToggleForceArrangeCommand}"
                    Visibility="{Binding CanForceArrange, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="20,0" Width="100">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsForceArrange}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonWarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- 強制安排篩選列（僅開啟時顯示） -->
        <Grid Margin="0,0,0,10"
              Visibility="{Binding IsForceArrange, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Margin="0,0,8,0"
                     materialDesign:HintAssist.Hint="{DynamicResource TuningFilterKeyword}"
                     Text="{Binding KeywordFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TuningTypeFilterOptions}"
                      SelectedValue="{Binding StatusFilter}"
                      SelectedValuePath="Value">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Value, Converter={StaticResource TuningTypeToLabelConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{DynamicResource PioFilterStatusAll}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- 品項選擇清單 -->
        <ListBox ItemsSource="{Binding FilteredEquipmentProducts}"
                 SelectedItem="{Binding SelectedEquipmentProduct}"
                 Background="{DynamicResource MaterialDesignPaper}"
                 Height="200"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="16" Padding="4,2"/>
                        <!-- 強制安排模式顯示各品項當前狀態 -->
                        <TextBlock Text="{Binding ProductionStatus, Converter={StaticResource TuningTypeToLabelConverter}, StringFormat='({0})'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="14" Padding="0,2" VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.IsForceArrange, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
