<UserControl x:Class="FProductionDashBoard.UserControls.EquipmentSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MaxHeight="320" />
        </Grid.RowDefinitions>

        <!-- DataGrid -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" HorizontalAlignment="Left" Margin="8,6"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="新增"/>
                </StackPanel>
            </Button>

            <DataGrid Grid.Row="1" Margin="8,0,8,4"
                      ItemsSource="{Binding EquipmentList}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="*"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                    <DataGridTextColumn Header="類型" Binding="{Binding Type.Name}" Width="80"/>
                    <DataGridTemplateColumn Header="操作" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="編輯">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="刪除"
                                            Foreground="{DynamicResource MaterialDesignValidationErrorBrush}">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesignDivider}"
                      Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Form Panel -->
        <Border Grid.Row="2"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="12,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding EditingId, StringFormat=編輯設備 (ID: {0}),
                           TargetNullValue=新增設備}"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Margin="4"
                             materialDesign:HintAssist.Hint="Code *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Row="0" Grid.Column="1" Margin="4"
                             materialDesign:HintAssist.Hint="Name *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Row="0" Grid.Column="2" Margin="4"
                             materialDesign:HintAssist.Hint="IP *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding FormIp, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Row="0" Grid.Column="3" Margin="4"
                             materialDesign:HintAssist.Hint="Port *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding FormPort, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Grid.Row="1" Grid.Column="0" Margin="4"
                              materialDesign:HintAssist.Hint="設備類型"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              ItemsSource="{Binding EquipmentTypes}"
                              SelectedValuePath="TypeId"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding FormTypeId}"/>

                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4"
                             materialDesign:HintAssist.Hint="廠區"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding FormFactory, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Row="1" Grid.Column="2" Margin="4"
                             materialDesign:HintAssist.Hint="棟別"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding FormBuilding, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Row="1" Grid.Column="3" Margin="4"
                             materialDesign:HintAssist.Hint="樓層"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding FormFloor, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBox Margin="4,4,4,0"
                         materialDesign:HintAssist.Hint="備註"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Error / Success messages -->
                <TextBlock Text="{Binding FormErrorString}" Margin="4,4,4,0"
                           Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                           Visibility="{Binding FormErrorString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>
                <TextBlock Text="{Binding FormSuccessString}" Margin="4,4,4,0"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Visibility="{Binding FormSuccessString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,4,4">
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding CancelCommand}"
                            Content="取消"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveCommand}"
                            Content="儲存"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
