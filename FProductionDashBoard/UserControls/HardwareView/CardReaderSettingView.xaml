<UserControl x:Class="FProductionDashBoard.UserControls.CardReaderSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,6">
            <Button Margin="0,0,8,0"
                    Command="{Binding RefreshPortsCommand}"
                    ToolTip="{DynamicResource CardReaderRefreshTooltip}"
                    Style="{StaticResource FunctionButtonStyle}">
                <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
            <Button Command="{Binding AddCommand}"
                    ToolTip="{DynamicResource CardReaderAddTooltip}"
                    Style="{StaticResource FunctionButtonStyle}">
                <materialDesign:PackIcon Kind="Plus" Width="40" Height="40"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </StackPanel>

        <!-- Reader list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Readers}" Margin="8,0,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                CornerRadius="4"
                                Padding="12,8"
                                Background="{DynamicResource PrimaryBackgroundBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>   <!-- Status dot -->
                                    <ColumnDefinition Width="140"/>    <!-- COM port -->
                                    <ColumnDefinition Width="140"/>    <!-- BaudRate -->
                                    <ColumnDefinition Width="*"/>      <!-- Status msg -->
                                    <ColumnDefinition Width="Auto"/>   <!-- Buttons -->
                                </Grid.ColumnDefinitions>

                                <!-- Connection status indicator -->
                                <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,12,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- COM port ComboBox -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="COM Port"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding DataContext.AvailablePorts,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding SelectedPort}"
                                              IsEditable="True"
                                              materialDesign:HintAssist.Hint="COM port"/>
                                </StackPanel>

                                <!-- BaudRate ComboBox -->
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Baud Rate"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding BaudRateOptions}"
                                              SelectedItem="{Binding SelectedBaudRate}"/>
                                </StackPanel>

                                <!-- Status message -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding StatusMessage}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding TestCommand}"
                                            ToolTip="{DynamicResource CardReaderTestTooltip}"
                                            Foreground="{DynamicResource SecondaryBrush}">
                                        <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18"/>
                                    </Button>
                                    <Button Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding ConnectCommand}"
                                            ToolTip="{DynamicResource CardReaderApplyTooltip}"
                                            Foreground="{DynamicResource PrimaryBrush}">
                                        <materialDesign:PackIcon Kind="Check" Width="18" Height="18"/>
                                    </Button>
                                    <Button Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding DeleteCommand}"
                                            ToolTip="{DynamicResource CardReaderDeleteTooltip}"
                                            Foreground="{DynamicResource ErrorBrush}">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
