<UserControl x:Class="FProductionDashBoard.UserControls.ModbusTcpSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:Background="White"
             d:DesignHeight="400" d:DesignWidth="1000">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,6">
            <Button Command="{Binding AddCommand}"
                    ToolTip="{DynamicResource ModbusTcpAddTooltip}"
                    Style="{StaticResource FunctionButtonStyle}">
                <materialDesign:PackIcon Kind="Plus" Width="40" Height="40"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </StackPanel>

        <!-- Device card list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Devices}" Margin="8,0,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                CornerRadius="4"
                                Padding="12,8"
                                Background="{DynamicResource PrimaryBackgroundBrush}">
                            <StackPanel>
                                <!-- 列 1：IP / Port / UnitId + 連線 + 狀態 chip + 刪除 -->
                                <!-- 列 2 / 3 在 IsConnected=True 後顯示（讀寫參數 + 結果清單）-->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- IP 位址 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource ModbusTcpIpHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Margin="0" Padding="0,3"
                                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="{DynamicResource ModbusTcpIpHint}"/>
                                    </StackPanel>

                                    <!-- 連接埠 -->
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource ModbusTcpPortHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Margin="0" Padding="0,3"
                                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="{DynamicResource ModbusTcpPortHint}"/>
                                    </StackPanel>

                                    <!-- Unit ID -->
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource ModbusTcpUnitIdHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Margin="0" Padding="0,3"
                                                 Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="{DynamicResource ModbusTcpUnitIdHint}"/>
                                    </StackPanel>

                                    <!-- 連線 / 斷線 -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                VerticalAlignment="Bottom">
                                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                     Width="20" Height="20" Margin="0,0,4,4"
                                                     IsIndeterminate="True"
                                                     VerticalAlignment="Bottom"
                                                     Visibility="{Binding ConnectCommand.IsRunning,
                                                                  Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Button Style="{StaticResource GridEditButtonStyle}"
                                                Command="{Binding ConnectCommand}"
                                                ToolTip="{DynamicResource ModbusTcpConnectTooltip}"
                                                Foreground="{DynamicResource PrimaryBrush}">
                                            <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource GridEditButtonStyle}"
                                                Command="{Binding DisconnectCommand}"
                                                ToolTip="{DynamicResource ModbusTcpDisconnectTooltip}"
                                                Foreground="{DynamicResource SecondaryBrush}">
                                            <materialDesign:PackIcon Kind="LanDisconnect" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- 狀態 chip + 訊息 -->
                                    <WrapPanel Grid.Column="4" Orientation="Horizontal"
                                               VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border CornerRadius="8" Padding="8,2" Margin="0,0,6,2"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource SecondaryBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource ModbusTcpConnLabel}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{DynamicResource ModbusTcpDisconnected}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource ModbusTcpConnected}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   TextWrapping="Wrap"/>
                                    </WrapPanel>

                                    <!-- 刪除 -->
                                    <Button Grid.Column="5"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding DeleteCommand}"
                                            ToolTip="{DynamicResource ModbusTcpDeleteTooltip}"
                                            Foreground="{DynamicResource ErrorBrush}">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </Grid>
                                <!-- 列 2：讀寫參數同列（IsConnected 後顯示）-->
                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>   <!-- 讀取按鈕 -->
                                        <ColumnDefinition Width="150"/>    <!-- 暫存器類型 -->
                                        <ColumnDefinition Width="90"/>     <!-- 起始位址 -->
                                        <ColumnDefinition Width="70"/>     <!-- 數量 -->
                                        <ColumnDefinition Width="120"/>    <!-- 值格式 -->
                                        <ColumnDefinition Width="16"/>     <!-- 間隔 -->
                                        <ColumnDefinition Width="Auto"/>   <!-- 寫入按鈕 -->
                                        <ColumnDefinition Width="90"/>     <!-- 寫入位址 -->
                                        <ColumnDefinition Width="*"/>      <!-- 寫入值 -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 讀取按鈕 + ProgressBar -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Bottom" Margin="0,0,4,0">
                                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                     Width="18" Height="18" Margin="0,0,2,4"
                                                     IsIndeterminate="True"
                                                     VerticalAlignment="Bottom"
                                                     Visibility="{Binding ReadCommand.IsRunning,
                                                                  Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Button Style="{StaticResource GridEditButtonStyle}"
                                                Command="{Binding ReadCommand}"
                                                ToolTip="{DynamicResource ModbusTcpReadTooltip}"
                                                Foreground="{DynamicResource PrimaryBrush}">
                                            <materialDesign:PackIcon Kind="DatabaseSearch" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- 暫存器類型 -->
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource ModbusTcpRegTypeHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding RegisterTypeOptions}"
                                                  SelectedItem="{Binding SelectedRegisterType}"/>
                                    </StackPanel>

                                    <!-- 起始位址 -->
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource ModbusTcpStartAddrHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Margin="0" Padding="0,3"
                                                 Text="{Binding ReadStartAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="{DynamicResource ModbusTcpStartAddrHint}"/>
                                    </StackPanel>

                                    <!-- 數量 -->
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource ModbusTcpCountHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Margin="0" Padding="0,3"
                                                 Text="{Binding ReadCount, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="{DynamicResource ModbusTcpCountHint}"/>
                                    </StackPanel>

                                    <!-- 值格式 -->
                                    <StackPanel Grid.Column="4" Margin="0,0,0,0">
                                        <TextBlock Text="{DynamicResource ModbusTcpValueFmtHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding ValueFormatOptions}"
                                                  SelectedItem="{Binding SelectedValueFormat}"/>
                                    </StackPanel>

                                    <!-- 間隔 -->
                                    <!-- Grid.Column="5" 空白間隔 -->

                                    <!-- 寫入按鈕 -->
                                    <Button Grid.Column="6"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding WriteCommand}"
                                            ToolTip="{DynamicResource ModbusTcpWriteTooltip}"
                                            Foreground="{DynamicResource SecondaryBrush}"
                                            IsEnabled="{Binding CanWrite}"
                                            Margin="0,0,4,0">
                                        <materialDesign:PackIcon Kind="DatabaseEdit" Width="18" Height="18"/>
                                    </Button>

                                    <!-- 寫入位址 -->
                                    <StackPanel Grid.Column="7" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource ModbusTcpWriteAddrHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Margin="0" Padding="0,3"
                                                 Text="{Binding WriteAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanWrite}"
                                                 materialDesign:HintAssist.Hint="{DynamicResource ModbusTcpWriteAddrHint}"/>
                                    </StackPanel>

                                    <!-- 寫入值 -->
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="{DynamicResource ModbusTcpWriteValueHint}"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Margin="0" Padding="0,3"
                                                 Text="{Binding WriteRawValue, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanWrite}"
                                                 materialDesign:HintAssist.Hint="{DynamicResource ModbusTcpWriteValueHint}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 列 3：讀取結果清單（IsConnected 後顯示）-->
                                <ListBox Margin="0,6,0,0"
                                         MaxHeight="120"
                                         ItemsSource="{Binding ReadResults}"
                                         FontFamily="Consolas"
                                         Background="{DynamicResource MaterialDesignPaper}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
