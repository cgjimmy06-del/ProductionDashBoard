<UserControl x:Class="FProductionDashBoard.UserControls.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FProductionDashBoard"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="800">
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" Margin="5" Padding="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <!-- 訊息視窗 -->
            <ListBox Grid.Column="0" x:Name="LogListBox"
                     Background="{DynamicResource BackgroundBrush}"
                     ItemsSource="{Binding CurrentLogs}"
                     local:ListBoxBehavior.AutoScrollToEnd="{Binding AutoScrollEnabled}">
                <!-- 行高/內距/文字大小/行距 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="24" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="FontWeight"  Value="Semibold" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsLargeFontMode,
                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                Value="True">
                                <Setter Property="Height" Value="32" />
                                <Setter Property="FontSize" Value="15" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <!-- 時間 -->
                            <TextBlock Margin="0,0,5,0" Foreground="{Binding Color}"
                                Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}"/>
                            <!-- 圖示 -->
                            <materialDesign:PackIcon Kind="{Binding Icon}"
                                Foreground="{Binding Color}" VerticalAlignment="Center"
                                Width="14" Height="14" Margin="0,0,5,0"/>
                            <!-- 訊息 -->
                            <TextBlock Margin="0,0,5,0" Foreground="{Binding Color}"
                                       Style="{StaticResource EllipsisTextBlock}"
                                       Text="{Binding Message}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 訊息視窗操作介面 -->
            <StackPanel Grid.Column="1" Margin="2" HorizontalAlignment="Center">
                <ToggleButton Width="25" Height="25" Margin="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource FunctionToggleButtonStyle}"
                        IsChecked="{Binding AutoScrollEnabled}"
                        ToolTip="{DynamicResource PinButtonTooltip}">
                    <materialDesign:PackIcon Kind="Pin"
                                         Width="25" Height="25"/>
                </ToggleButton>
                <ToggleButton Width="25" Height="25" Margin="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource FunctionToggleButtonStyle}"
                        IsChecked="{Binding IsErrorMode}"
                        ToolTip="{DynamicResource ErrorLogButtonTooltip}">
                    <materialDesign:PackIcon Kind="{Binding Log.IsNewErrorLog,
                                Converter={StaticResource BoolToAlertConverter}}"
                                         Width="23" Height="23"/>
                </ToggleButton>
                <ToggleButton Width="25" Height="25" Margin="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource FunctionToggleButtonStyle}"
                        IsChecked="{Binding IsLargeFontMode}"
                        ToolTip="{DynamicResource LargeFontButtonTooltip}">
                    <materialDesign:PackIcon Kind="AlphaBCircleOutline"
                                         Width="25" Height="25"/>
                </ToggleButton>
                <Button Width="25" Height="25" Margin="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="0"
                        Style="{StaticResource FunctionButtonStyle}"
                        Command="{Binding SaveLogsCommand}"
                        ToolTip="{DynamicResource LogSaveButtonTooltip}">
                    <materialDesign:PackIcon Kind="DownloadCircleOutline"
                                         Width="25" Height="25"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
