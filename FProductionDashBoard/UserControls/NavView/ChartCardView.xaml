<UserControl x:Class="FProductionDashBoard.UserControls.ChartCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="190">

    <!-- 圖表卡片（DataContext＝ChartRowViewModel）：檢視端卡片牆與設計器左預覽共用 -->
    <Border Width="190" CornerRadius="8" Margin="0,0,10,10" Padding="10"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderThickness="2"
            BorderBrush="{Binding BorderBrushKey, Converter={StaticResource BrushKeyToBrushConverter}}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
        </Border.Effect>
        <StackPanel>

            <!-- 標題：主名稱 + 右上狀態色點 -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="{Binding Title}"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,14,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <Ellipse Width="10" Height="10"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Fill="{Binding BorderBrushKey, Converter={StaticResource BrushKeyToBrushConverter}}"/>
            </Grid>

            <!-- Chip 獨立列（wrap，有值才顯示） -->
            <ItemsControl ItemsSource="{Binding Chips}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="6,2" Margin="0,0,4,2"
                                Background="{Binding BrushKey, Converter={StaticResource BrushKeyToBrushConverter}}">
                            <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDarkBrush}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 次要資訊（每列一欄位） -->
            <ItemsControl ItemsSource="{Binding SecondaryInfos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,4,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Text}" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 進度條（分子/分母） -->
            <StackPanel Margin="0,2,0,0"
                        Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8"/>
                <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,2,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
