<UserControl x:Class="FProductionDashBoard.UserControls.ChartDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:localuc="clr-namespace:FProductionDashBoard.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <!-- 圖表設計器（DataContext＝ChartDesignerViewModel）：左預覽（假資料）右編輯 -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0：頂列 -->
            <RowDefinition Height="Auto"/>  <!-- Row 1：失效引用淨化提示 -->
            <RowDefinition Height="*"/>     <!-- Row 2：左右分割 -->
        </Grid.RowDefinitions>

        <!-- ========== Row 0：頂列（← 返回＝取消 / 標題 / 取消＋儲存） ========== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource CancelButton}"
                        Style="{DynamicResource FunctionButtonStyle}"
                        Background="{DynamicResource SecondaryBrush}"
                        Padding="8,2" Height="Auto" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"/>
                <Button Content="{DynamicResource SaveButton}"
                        Style="{DynamicResource FunctionButtonStyle}"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="8,2" Height="Auto"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource ChartDesignerBack}"
                        Style="{DynamicResource FunctionButtonStyle}"
                        Background="{DynamicResource SecondaryBrush}"
                        Padding="8,2" Height="Auto" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"/>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource ChartDesignerEditTitle}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource ChartDesignerNewTitle}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DisplayName}" FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- ========== Row 1：淨化提示（開啟時剔除失效引用才顯示） ========== -->
        <TextBlock Grid.Row="1" Text="{Binding SanitizeNotice}"
                   Foreground="{DynamicResource WarningBrush}" FontSize="13"
                   Margin="0,0,0,8"
                   Visibility="{Binding HasSanitizeNotice, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ========== Row 2：左預覽（5）｜右編輯（4） ========== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：預覽（上＝大框架、下＝單卡/單列樣本），皆以假資料渲染 -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource ChartDesignerFrameworkPreview}"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <!-- 大框架預覽：統計列 / 篩選列示意 / 容器 -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 統計列 -->
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding PreviewStatItems}" Margin="0,0,0,5"
                                      Visibility="{Binding IsPreviewStatVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabelStyle}"/>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource StatNumberStyle}"
                                                       Foreground="{Binding ColorKey, Converter={StaticResource BrushKeyToBrushConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 篩選列示意（僅排版示意，不可互動） -->
                        <WrapPanel Grid.Row="1" Margin="0,2,0,8"
                                   Visibility="{Binding IsPreviewFilterVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding PreviewFilterLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8,3" Margin="0,0,6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <materialDesign:PackIcon Kind="MenuDown" Width="14" Height="14"
                                                                         Margin="4,0,0,0" VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding PreviewQuickLabels}" Margin="4,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource ChartQuickFilterButtonStyle}"
                                                      Content="{Binding}" IsHitTestVisible="False"
                                                      Margin="0,0,6,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewSortLabel}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{DynamicResource ChartSortHint}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding PreviewSortLabel}" FontSize="12" Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="▲" FontSize="10" Margin="2,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- 容器：卡片牆 -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsPreviewCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding PreviewRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <localuc:ChartCardView/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 容器：表格（欄位由 code-behind 依定義動態建立） -->
                        <DataGrid x:Name="PreviewTable" Grid.Row="2"
                                  ItemsSource="{Binding PreviewRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="False" CanUserReorderColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  FontSize="14" RowHeight="30"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                                  Visibility="{Binding IsPreviewTable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="{DynamicResource ChartDesignerSamplePreview}"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,4"/>

                <!-- 單卡 / 單列樣本 -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding PreviewSampleRows}" HorizontalAlignment="Left"
                                      Visibility="{Binding IsPreviewCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <localuc:ChartCardView/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DataGrid x:Name="SampleTable"
                                  ItemsSource="{Binding PreviewSampleRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="False" CanUserReorderColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single"
                                  FontSize="14" RowHeight="30"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                                  Visibility="{Binding IsPreviewTable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右：編輯選項（基本／統計列／篩選列／容器，C2、C3 填入） -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource ChartDesignerOptionsTitle}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
