<UserControl x:Class="FProductionDashBoard.UserControls.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0：圖表操作列（不縮放） -->
            <RowDefinition Height="*"/>     <!-- Row 1：內容區（單一 LayoutTransform 等比縮放） -->
        </Grid.RowDefinitions>

        <!-- ========== Row 0：圖表操作列 ========== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">

            <!-- 右：縮放檔位 ＋ icon 群（設計器功能屬 Stage 3，僅顯示） -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                        Margin="0,0,8,0" ToolTip="{DynamicResource ChartZoomTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Command="{Binding ZoomOutCommand}"
                                Style="{StaticResource ChartIconButtonStyle}"/>
                        <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}"
                                   VerticalAlignment="Center" MinWidth="42" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Content="＋" Command="{Binding ZoomInCommand}"
                                Style="{StaticResource ChartIconButtonStyle}"/>
                    </StackPanel>
                </Border>

                <Button IsEnabled="False" Style="{StaticResource ChartIconButtonStyle}"
                        ToolTip="{DynamicResource ChartAddTooltip}">
                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                </Button>
                <Button IsEnabled="False" Style="{StaticResource ChartIconButtonStyle}"
                        ToolTip="{DynamicResource ChartEditTooltip}">
                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                </Button>
                <Button IsEnabled="False" Style="{StaticResource ChartIconButtonStyle}"
                        ToolTip="{DynamicResource ChartCopyTooltip}">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="17" Height="17"/>
                </Button>
                <Button IsEnabled="False" Style="{StaticResource ChartIconButtonStyle}"
                        ToolTip="{DynamicResource ChartDeleteTooltip}">
                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                </Button>
                <Button IsEnabled="False" Style="{StaticResource ChartIconButtonStyle}"
                        ToolTip="{DynamicResource ChartExportTooltip}">
                    <materialDesign:PackIcon Kind="TrayArrowUp" Width="18" Height="18"/>
                </Button>
                <Button IsEnabled="False" Style="{StaticResource ChartIconButtonStyle}"
                        ToolTip="{DynamicResource ChartImportTooltip}">
                    <materialDesign:PackIcon Kind="TrayArrowDown" Width="18" Height="18"/>
                </Button>
            </StackPanel>

            <!-- 左：圖表頁籤（預設圖表帶鎖定標記） -->
            <ListBox ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     Style="{StaticResource ChartTabListBoxStyle}"
                     ItemContainerStyle="{StaticResource ChartTabItemStyle}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Lock" Width="12" Height="12"
                                                     Margin="0,0,4,0" VerticalAlignment="Center"
                                                     ToolTip="{DynamicResource ChartDefaultLockedTooltip}"
                                                     Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ========== Row 1：內容區（統計列＋篩選列＋容器，整體等比縮放） ========== -->
        <Grid Grid.Row="1">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 統計列 -->
                <RowDefinition Height="Auto"/>  <!-- 篩選列 -->
                <RowDefinition Height="*"/>     <!-- 容器 -->
            </Grid.RowDefinitions>

            <!-- 統計列 -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding StatItems}" Margin="0,0,0,5"
                          Visibility="{Binding IsStatRowVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatCardBorderStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabelStyle}"/>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource StatNumberStyle}"
                                           Foreground="{Binding ColorKey, Converter={StaticResource BrushKeyToBrushConverter}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 篩選列：左＝篩選欄位＋快捷按鈕（WrapPanel 折行），右＝排序＋恢復預設 -->
            <DockPanel Grid.Row="1" Margin="0,2,0,8"
                       Visibility="{Binding IsFilterRowVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox MinWidth="120" Margin="8,0,2,0"
                              materialDesign:HintAssist.Hint="{DynamicResource ChartSortHint}"
                              ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedSortOption}"/>
                    <Button Command="{Binding ToggleSortDirectionCommand}"
                            Style="{StaticResource ChartIconButtonStyle}"
                            ToolTip="{DynamicResource ChartSortHint}">
                        <TextBlock FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▲"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSortDescending}" Value="True">
                                            <Setter Property="Text" Value="▼"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Command="{Binding RestoreDefaultsCommand}"
                            Style="{StaticResource ChartIconButtonStyle}"
                            ToolTip="{DynamicResource ChartRestoreDefaultTooltip}">
                        <materialDesign:PackIcon Kind="Restore" Width="18" Height="18"/>
                    </Button>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <!-- 篩選欄位（型別決定控件） -->
                    <ItemsControl ItemsSource="{Binding FilterFields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,2">
                                    <ComboBox MinWidth="130"
                                              materialDesign:HintAssist.Hint="{Binding Label}"
                                              ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedOption}"
                                              Visibility="{Binding IsEnum, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBox MinWidth="150"
                                             materialDesign:HintAssist.Hint="{Binding Label}"
                                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsDate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DatePicker Width="120"
                                                    materialDesign:HintAssist.Hint="{Binding Label}"
                                                    SelectedDate="{Binding DateStart}"/>
                                        <TextBlock Text="~" VerticalAlignment="Center" Margin="4,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <DatePicker Width="120" SelectedDate="{Binding DateEnd}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 快捷按鈕（AND 疊加、再按取消、同欄位互斥） -->
                    <ItemsControl ItemsSource="{Binding QuickButtons}" Margin="4,0,0,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource ChartQuickFilterButtonStyle}"
                                              Content="{Binding Label}"
                                              IsChecked="{Binding IsActive}"
                                              Margin="0,0,6,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </DockPanel>

            <!-- 容器 -->
            <Grid Grid.Row="2">

                <!-- 卡片牆容器 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsCardContainer, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding RowsView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="190" CornerRadius="8" Margin="0,0,10,10" Padding="10"
                                        Background="{DynamicResource PrimaryBackgroundBrush}"
                                        BorderThickness="2"
                                        BorderBrush="{Binding BorderBrushKey, Converter={StaticResource BrushKeyToBrushConverter}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                                    </Border.Effect>
                                    <StackPanel>

                                        <!-- 標題：主名稱 + 右上狀態色點 -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="16" FontWeight="SemiBold" Margin="0,0,14,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Ellipse Width="10" Height="10"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Fill="{Binding BorderBrushKey, Converter={StaticResource BrushKeyToBrushConverter}}"/>
                                        </Grid>

                                        <!-- Chip 獨立列（wrap，有值才顯示） -->
                                        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,0,0,6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Padding="6,2" Margin="0,0,4,2"
                                                            Background="{Binding BrushKey, Converter={StaticResource BrushKeyToBrushConverter}}">
                                                        <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextDarkBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 次要資訊（每列一欄位） -->
                                        <ItemsControl ItemsSource="{Binding SecondaryInfos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,4,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Text}" FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 進度條（分子/分母） -->
                                        <StackPanel Margin="0,2,0,0"
                                                    Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8"/>
                                            <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,2,0,0"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 表格容器（欄位由 code-behind 依定義動態建立） -->
                <DataGrid x:Name="ChartTable"
                          ItemsSource="{Binding RowsView}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="False" CanUserReorderColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Single"
                          FontSize="14" RowHeight="30"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2"
                          Visibility="{Binding IsTableContainer, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 空狀態（無任何圖表定義時） -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="ChartBox" Width="72" Height="72"
                                             Foreground="{DynamicResource BorderBrush}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource ChartEmptyPlaceholder}"
                               FontSize="22" FontWeight="Medium"
                               Foreground="{DynamicResource BorderBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
