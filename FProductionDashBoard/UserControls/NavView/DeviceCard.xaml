<UserControl x:Class="FProductionDashBoard.UserControls.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localuc="clr-namespace:FProductionDashBoard.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="600" d:Background="White">
    <!-- 卡片樣式綁在 Border -->
    <UserControl.Resources>
        <Style TargetType="Border" x:Key="CardBorderStyle">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <!-- 陰影 -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="12"
                                      ShadowDepth="3"
                                      Opacity="0.25"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hover 效果 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black"
                                              BlurRadius="15"
                                              ShadowDepth="4"
                                              Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <!-- 點擊 效果 -->
                <EventTrigger RoutedEvent="PreviewMouseDown">
                    <BeginStoryboard Storyboard="{StaticResource PressDownStoryboard}"/>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseUp">
                    <BeginStoryboard Storyboard="{StaticResource ReleaseStoryboard}"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="12"
            Padding="0"
            BorderBrush="{DynamicResource PrimaryHueLightBrush}"
            BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 左側狀態燈號 -->
                <ColumnDefinition Width="15"/>
                <!-- 主體內容 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 狀態燈號 -->
            <Border Grid.Column="0"
                    Background="{Binding Info.Status, Converter={StaticResource IntToColorConverter}}"
                    d:Background="Green"
                    CornerRadius="3"/>

            <!-- 主體內容 -->
            <StackPanel Grid.Column="1" Margin="5,0,0,0" Orientation="Vertical">

                <!-- 機台名稱列 -->
                <DockPanel Margin="0,5,5,0">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding OrderCommand}"
                            VerticalAlignment="Center"
                            Width="36" Height="36"
                            Padding="6">
                        <materialDesign:PackIcon Kind="ClipboardListOutline" Width="20" Height="20"/>
                    </Button>
                    <TextBlock Text="{Binding Info.Name}" d:Text="A1"
                               FontWeight="Bold" FontSize="30" Cursor="Hand"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 資訊列 -->
                <StackPanel Orientation="Horizontal" Margin="5,2,5,0">
                    <materialDesign:PackIcon Kind="TagOutline"
                                            Width="16" Height="16"
                                            Foreground="{DynamicResource TextLightBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CurrentProductDisplayName}"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <materialDesign:PackIcon Kind="AccountOutline"
                                            Width="16" Height="16"
                                            Foreground="{DynamicResource TextLightBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CurrentUser.Name}"
                               Foreground="{DynamicResource TextLightBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 狀態列 -->
                <StackPanel Orientation="Horizontal" Margin="5,4,5,2">
                    <!-- 時段 chip -->
                    <Border CornerRadius="8"
                            BorderBrush="{DynamicResource SecondaryBrush}"
                            BorderThickness="1"
                            Padding="8,2"
                            Margin="0,0,6,0"
                            Visibility="{Binding HasCurrentTimeSlot, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding CurrentTimeSlotLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- 生產中 chip -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource PrimaryBrush}"
                            Padding="8,2"
                            Visibility="{Binding IsProducing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource DeviceInProduction}"
                                   FontSize="11"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- 按鈕列 -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Margin="0, 5, 5, 5"
                            Style="{DynamicResource DeviceMainButtonStyle}"
                            Content="{DynamicResource MetarialChangeButton}"
                            Command="{Binding MaterialsChangeCommand}"/>

                    <Button Margin="5"
                            Style="{DynamicResource DeviceMainButtonStyle}"
                            Content="{DynamicResource FirstInspectionButton}"
                            Command="{Binding FirstInspectionCommand}"
                            Background="{Binding FirstInspectionStatus, 
                                    Converter={StaticResource BoolToColorConverter},
                                    ConverterParameter='NoError'}">
                    </Button>

                    <Button Margin="5"
                            Style="{DynamicResource DeviceMainButtonStyle}"
                            Content="{DynamicResource RoutineInspectionButton}" 
                            Command="{Binding RoutineInspectionCommand}"/>

                    <Button Margin="5"
                            Style="{DynamicResource DeviceMainButtonStyle}"
                            Content="{DynamicResource OperationButton}" 
                            Command="{Binding TuningCommand}"/>
                </StackPanel>

                <!-- 巡檢燈 -->
                <ItemsControl ItemsSource="{Binding TimeSlotsStatus}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Margin="10,5,10,0"
                                         Columns="{Binding TimeSlotsStatus.Count}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Height="10" Margin="5"
                       Fill="{Binding Converter={StaticResource IntToColorConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <!-- 調試計時覆蓋層 -->
            <Button Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource TuningOverlayButtonStyle}"
                    Command="{Binding EndTuningCommand}"
                    Visibility="{Binding IsTuning, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TuningStatusText}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource TuningClickToEnd}"
                               FontSize="12"
                               Foreground="#555555"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Button>

        </Grid>
    </Border>
</UserControl>
