<UserControl x:Class="FProductionDashBoard.UserControls.OperationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FProductionDashBoard"
             xmlns:localuc="clr-namespace:FProductionDashBoard.UserControls"
             xmlns:localvm="clr-namespace:FProductionDashBoard.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500" d:Background="White">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 統一操作區 -->
        <Border Grid.Row="0" Margin="2" Padding="2" Height="50"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Margin="2"
                                                HorizontalAlignment="Center">
                <Button Height="40" Width="80" Margin="5,0"
                                            Command="{Binding FirstArticleInsAllCommand}"
                                            ToolTip="{DynamicResource FirstInsAllButtonTooltip}">
                    <materialDesign:PackIcon Kind="TagCheck"
                                                     Width="30" Height="30"/>
                </Button>
                <Button Height="40" Width="80" Margin="5,0"
                                            Command="{Binding RoutineInsAllCommand}"
                                            ToolTip="{DynamicResource RoutineInsAllButtonTooltip}">
                    <materialDesign:PackIcon Kind="ClockCheck"
                                                     Width="30" Height="30"/>
                </Button>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 設備卡片陣列 -->
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <localuc:DeviceCardView Style="{StaticResource MainCardStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 卡片新增操作區(在此滾動) -->
            </StackPanel>
        </ScrollViewer>
        <!-- 卡片新增操作區(在此固定) -->
        <Border Grid.Row="2" Margin="2" Padding="2" Height="50"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Margin="2"
                                                HorizontalAlignment="Center">
                <Button Height="40" Width="80" Margin="5,0"
                                            Command="{Binding AddDevicesCommand}"
                                            ToolTip="{DynamicResource AddDeviceButtonTooltip}">
                    <materialDesign:PackIcon Kind="ShapeRectangleAdd"
                                                     Width="30" Height="30"/>
                </Button>
                <Button Height="40" Width="80" Margin="5,0" Padding="0"
                                            Command="{Binding FastUploadDevicesCommand}"
                                            ToolTip="{DynamicResource FastUploadButtonTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LightningBolt"
                                                     Width="20" Height="20" VerticalAlignment="Top"/>
                        <materialDesign:PackIcon Kind="FileUpload"
                                                     Width="30" Height="30"/>
                    </StackPanel>
                </Button>
                <Button Height="40" Width="80" Margin="5,0" Padding="0"
                                            Command="{Binding FastDownloadDevicesCommand}"
                                            ToolTip="{DynamicResource FastDownloadButtonTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LightningBolt"
                                                     Width="20" Height="20" VerticalAlignment="Top"/>
                        <materialDesign:PackIcon Kind="FileDownload"
                                                     Width="30" Height="30"/>
                    </StackPanel>
                </Button>
                <Button Height="40" Width="80" Margin="5,0"
                                            Command="{Binding DeleteDevicesCommand}"
                                            ToolTip="{DynamicResource DeleteDevicesButtonTooltip}">
                    <materialDesign:PackIcon Kind="Delete"
                                                     Width="30" Height="30"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
