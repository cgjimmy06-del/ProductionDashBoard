<UserControl x:Class="FProductionDashBoard.UserControls.ProductInOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:FProductionDashBoard"
             xmlns:localvm="clr-namespace:FProductionDashBoard.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 日期篩選列 -->
            <RowDefinition Height="Auto"/>  <!-- 統計列 -->
            <RowDefinition Height="Auto"/>  <!-- 篩選列 -->
            <RowDefinition Height="Auto"/>  <!-- 折疊箭頭 -->
            <RowDefinition Height="*"/>     <!-- 主內容 -->
        </Grid.RowDefinitions>
        
        <!-- ========== Row0：日期篩選列 ========== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5"
                    Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DatePicker SelectedDate="{Binding DateRangeStart}"
                        materialDesign:HintAssist.Hint="{DynamicResource PioFilterDateStart}"
                        Width="130" Margin="0,0,4,0"/>
            <TextBlock Text="~" VerticalAlignment="Center" Margin="0,0,4,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <DatePicker SelectedDate="{Binding DateRangeEnd}"
                        materialDesign:HintAssist.Hint="{DynamicResource PioFilterDateEnd}"
                        Width="130" Margin="0,0,12,0"/>
            <Button Content="{DynamicResource PioShortcutToday}"
                    Style="{DynamicResource FunctionButtonStyle}"
                    Background="{DynamicResource SecondaryBrush}"
                    Padding="8,2" Height="Auto" Margin="0,0,4,0"
                    Command="{Binding SetDateTodayCommand}"/>
            <Button Content="{DynamicResource PioShortcutLast3Days}"
                    Style="{DynamicResource FunctionButtonStyle}"
                    Background="{DynamicResource SecondaryBrush}"
                    Padding="8,2" Height="Auto" Margin="0,0,4,0"
                    Command="{Binding SetDateLast3DaysCommand}"/>
            <Button Content="{DynamicResource PioShortcutLast5Days}"
                    Style="{DynamicResource FunctionButtonStyle}"
                    Background="{DynamicResource SecondaryBrush}"
                    Padding="8,2" Height="Auto" Margin="0,0,4,0"
                    Command="{Binding SetDateLast5DaysCommand}"/>
            <Button Content="{DynamicResource PioShortcutCurrentWeek}"
                    Style="{DynamicResource FunctionButtonStyle}"
                    Background="{DynamicResource SecondaryBrush}"
                    Padding="8,2" Height="Auto" Margin="0,0,4,0"
                    Command="{Binding SetDateCurrentWeekCommand}"/>
            <Button Content="{DynamicResource PioShortcutCurrentMonth}"
                    Style="{DynamicResource FunctionButtonStyle}"
                    Background="{DynamicResource SecondaryBrush}"
                    Padding="8,2" Height="Auto"
                    Command="{Binding SetDateCurrentMonthCommand}"/>
        </StackPanel>
        
        <!-- ========== Row1：統計列 ========== -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,5"
                     Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Style="{StaticResource StatCardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource PioStatTotalLabel}" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding StatTotal}" Style="{StaticResource StatNumberStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatTotalQty, StringFormat='{}{0:N0} pcs'}" 
                               Style="{StaticResource StatQtyStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource PioStatPendingLabel}" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding StatPending}" Style="{StaticResource StatNumberStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding StatPendingQty, StringFormat='{}{0:N0} pcs'}" 
                               Style="{StaticResource StatQtyStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource PioStatScheduledLabel}" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding StatScheduled}" Style="{StaticResource StatNumberStyle}"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding StatScheduledQty, StringFormat='{}{0:N0} pcs'}" 
                               Style="{StaticResource StatQtyStyle}"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource PioStatCompletedLabel}" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding StatCompleted}" Style="{StaticResource StatNumberStyle}"
                               Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{Binding StatCompletedQty, StringFormat='{}{0:N0} pcs'}" 
                               Style="{StaticResource StatQtyStyle}"
                               Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardBorderStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource PioStatReleasedLabel}" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding StatReleased}" Style="{StaticResource StatNumberStyle}"
                               Foreground="{DynamicResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding StatReleasedQty, StringFormat='{}{0:N0} pcs'}" 
                               Style="{StaticResource StatQtyStyle}"
                               Foreground="{DynamicResource SecondaryBrush}"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ========== Row2：篩選列 ========== -->
        <Grid Grid.Row="2" Margin="0,0,0,2"
              Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 狀態篩選 -->
            <ComboBox Grid.Column="0" Margin="0,0,6,0"
                      ItemsSource="{Binding StatusFilterOptions}"
                      SelectedValue="{Binding StatusFilter}"
                      SelectedValuePath="Value">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Value, Converter={StaticResource ScheduleStatusToLabelConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{DynamicResource PioFilterStatusAll}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 件號/品牌/型號 搜尋 -->
            <TextBox Grid.Column="1" Margin="0,0,6,0"
                     materialDesign:HintAssist.Hint="{DynamicResource PioFilterPartModel}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>

            <!-- 工序 搜尋 -->
            <TextBox Grid.Column="2" Margin="0,0,6,0"
                     materialDesign:HintAssist.Hint="{DynamicResource PioFilterProcess}"
                     Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>

            <!-- + 入料按鈕 -->
            <Button Grid.Column="3" Margin="0,0,6,0"
                    Content="{DynamicResource PioReceiveButton}"
                    Style="{DynamicResource FunctionButtonStyle}"
                    Background="{DynamicResource SecondaryBrush}"
                    Command="{Binding OpenFormCommand}"/>
        </Grid>

        <!-- ========== Row3：篩選面板切換 ========== -->
        <Button Grid.Row="3"
                Style="{StaticResource FilterPanelToggleButtonStyle}"
                Command="{Binding ToggleFilterPanelCommand}"
                ToolTip="{DynamicResource FilterPanelToggleTooltip}">
            <materialDesign:PackIcon Width="16" Height="16">
                <materialDesign:PackIcon.Style>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Kind" Value="ChevronUp"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterPanelVisible}" Value="False">
                                <Setter Property="Kind" Value="ChevronDown"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
        </Button>

        <!-- ========== Row4：DataGrid + 右側面板 ========== -->
        <Grid Grid.Row="4" x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 左欄：DataGrid -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding SchedulesView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
                <DataGrid.Columns>

                    <!-- # -->
                    <DataGridTextColumn Header="{DynamicResource PioColScheduleId}"
                                        Binding="{Binding ScheduleId}"
                                        Width="50"/>

                    <!-- 品牌 -->
                    <DataGridTextColumn Header="{DynamicResource PioColBrand}"
                                        Binding="{Binding BrandName}"
                                        Width="50"/>

                    <!-- 件號 -->
                    <DataGridTextColumn Header="{DynamicResource PioColPartNo}"
                                        Binding="{Binding PartNo}"
                                        Width="70"/>

                    <!-- 型號 -->
                    <DataGridTextColumn Header="{DynamicResource PioColModel}"
                                        Binding="{Binding ModelName}"
                                        Width="50"/>

                    <!-- 工序 -->
                    <DataGridTextColumn Header="{DynamicResource PioColProcess}"
                                        Binding="{Binding ProcessName}"
                                        Width="70"/>

                    <!-- 數量 -->
                    <DataGridTextColumn Header="{DynamicResource PioColQty}"
                                        Binding="{Binding Quantity}"
                                        Width="55"/>

                    <!-- 實際數量 -->
                    <DataGridTemplateColumn Header="{DynamicResource PioColActualQty}" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ActualQuantity, TargetNullValue='-'}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Padding="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 入料時間 -->
                    <DataGridTextColumn Header="{DynamicResource PioColReceivedAt}"
                                        Binding="{Binding ReceivedAt, StringFormat='MM/dd HH:mm'}"
                                        Width="90"/>

                    <!-- 出料時間 -->
                    <DataGridTemplateColumn Header="{DynamicResource PioColReleasedAt}" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ReleasedAt, StringFormat='MM/dd HH:mm', TargetNullValue='-'}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Padding="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 狀態（彩色 + 點擊開啟詳情） -->
                    <DataGridTemplateColumn Header="{DynamicResource PioColStatus}" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4,2"
                                        Height="Auto"
                                        Command="{Binding DataContext.OpenDetailCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,4,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Status,
                                                        Converter={StaticResource ScheduleStatusToBrushConverter}}"/>
                                        <TextBlock Text="{Binding Status,
                                                          Converter={StaticResource ScheduleStatusToLabelConverter}}"
                                                   Foreground="{Binding Status,
                                                               Converter={StaticResource ScheduleStatusToBrushConverter}}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 操作 -->
                    <DataGridTemplateColumn Header="{DynamicResource PioColActions}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <!-- Pending: 強制完成 + 取消 -->
                                    <Button Content="{DynamicResource PioOpForceComplete}"
                                            Margin="2,1" Padding="6,2" Height="Auto"
                                            Style="{StaticResource PioForceCompleteButtonStyle}"
                                            Command="{Binding DataContext.ForceCompleteCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Scheduled: 確認完成 -->
                                    <Button Content="{DynamicResource PioOpVerify}"
                                            Margin="2,1" Padding="6,2" Height="Auto"
                                            Style="{StaticResource PioVerifyButtonStyle}"
                                            Command="{Binding DataContext.VerifyCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Completed: 出料 + 拆單 -->
                                    <Button Content="{DynamicResource PioOpRelease}"
                                            Margin="2,1" Padding="6,2" Height="Auto"
                                            Style="{StaticResource PioReleaseButtonStyle}"
                                            Command="{Binding DataContext.ReleaseCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{DynamicResource PioOpSplit}"
                                            Margin="2,1" Padding="6,2" Height="Auto"
                                            Style="{StaticResource PioSplitButtonStyle}"
                                            Command="{Binding DataContext.SplitCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Pending / Scheduled: 取消 -->
                                    <Button Content="{DynamicResource PioOpCancel}"
                                            Margin="2,1" Padding="6,2" Height="Auto"
                                            Style="{StaticResource PioCancelButtonStyle}"
                                            Command="{Binding DataContext.CancelScheduleCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ResizeDirection="Columns"
                          Visibility="{Binding IsPanelVisible,
                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- 右側面板 -->
            <Border Grid.Column="2"
                    Visibility="{Binding IsPanelVisible,
                                 Converter={StaticResource BooleanToVisibilityConverter}}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 面板標題列 -->
                    <Grid Grid.Row="0" Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PanelMode}"
                                                     Value="{x:Static localvm:ProductInOutPanelMode.Detail}">
                                            <Setter Property="Text" Value="{DynamicResource PioDetailTitle}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PanelMode}"
                                                     Value="{x:Static localvm:ProductInOutPanelMode.Form}">
                                            <Setter Property="Text" Value="{DynamicResource PioFormTitle}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                Width="24" Height="24" Padding="0"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Command="{Binding ClosePanelCommand}">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <!-- Detail 模式 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Margin="8,0,8,8">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PanelMode}"
                                                 Value="{x:Static localvm:ProductInOutPanelMode.Detail}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel DataContext="{Binding SelectedSchedule}">

                            <!-- ── Header：排程 ID + 狀態 ── -->
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="#"/><Run Text="{Binding ScheduleId}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="15"  FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Status, Converter={StaticResource ScheduleStatusToBrushConverter}}"
                                           Text="{Binding Status, Converter={StaticResource ScheduleStatusToLabelConverter}}"/>
                            </Grid>

                            <!-- ── 物料區 ── -->
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource DetailSectionHeaderStyle}"
                                           Text="{DynamicResource PioSectionProduct}"/>
                                <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Fill="{DynamicResource BorderBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioColPartNo}"/>
                                    <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding PartNo}"/>
                                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioColModel}"/>
                                    <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding ModelName}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioColBrand}"/>
                                    <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding BrandName}"/>
                                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioColProcess}"/>
                                    <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding ProcessName}"/>
                                </StackPanel>
                            </Grid>
                            <!-- 來料編號（有值才顯示） -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LotNo}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioDetailLotNo}"/>
                                <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding LotNo}"/>
                            </StackPanel>

                            <!-- ── 數量區 ── -->
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource DetailSectionHeaderStyle}"
                                           Text="{DynamicResource PioDetailQty}"/>
                                <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Fill="{DynamicResource BorderBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource DetailLabelStyle}"
                                           Text="{DynamicResource PioFlowReceive}" Margin="0,6,4,1"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValueStyle}"
                                           Text="{Binding Quantity}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                <TextBlock Grid.Column="3" Style="{StaticResource DetailLabelStyle}"
                                           Text="{DynamicResource PioDetailActualQty}" Margin="0,6,4,1"/>
                                <TextBlock Grid.Column="4" Style="{StaticResource DetailValueStyle}"
                                           Text="{Binding ActualQuantity, TargetNullValue='-'}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </Grid>

                            <!-- ── 流程區 ── -->
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource DetailSectionHeaderStyle}"
                                           Text="{DynamicResource PioSectionFlow}"/>
                                <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Fill="{DynamicResource BorderBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <!-- 入料 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioFlowReceive}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValueStyle}" Text="{Binding ReceivedByName, TargetNullValue='-'}" Margin="4,6,0,1"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource DetailValueStyle}" TextAlignment="Left"
                                           Text="{Binding ReceivedAt, StringFormat='MM-dd HH:mm', TargetNullValue='-'}" Margin="0,6,0,1"/>
                                <!-- 排單 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioFlowSchedule}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValueStyle}" Text="{Binding ScheduledByName, TargetNullValue='-'}" Margin="4,6,0,1"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource DetailValueStyle}" TextAlignment="Left"
                                           Text="{Binding ScheduledAt, StringFormat='MM-dd HH:mm', TargetNullValue='-'}" Margin="0,6,0,1"/>
                                <!-- 審核 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioFlowVerify}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValueStyle}" Text="{Binding VerifiedByName, TargetNullValue='-'}" Margin="4,6,0,1"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource DetailValueStyle}" TextAlignment="Left"
                                           Text="{Binding VerifiedAt, StringFormat='MM-dd HH:mm', TargetNullValue='-'}" Margin="0,6,0,1"/>
                                <!-- 出料 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource PioFlowRelease}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValueStyle}" Text="{Binding ReleasedByName, TargetNullValue='-'}" Margin="4,6,0,1"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource DetailValueStyle}" TextAlignment="Left"
                                           Text="{Binding ReleasedAt, StringFormat='MM-dd HH:mm', TargetNullValue='-'}" Margin="0,6,0,1"/>
                            </Grid>

                            <!-- ── 備註區（有值才顯示） ── -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DetailSectionHeaderStyle}"
                                               Text="{DynamicResource PioDetailDescription}"/>
                                    <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center"
                                               Margin="6,0,0,0" Fill="{DynamicResource BorderBrush}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource DetailValueStyle}" Text="{Binding Description}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- ── 父單區（有值才顯示） ── -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ParentId}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource DetailSectionHeaderStyle}"
                                               Text="{DynamicResource PioDetailParentId}"/>
                                    <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center"
                                               Margin="6,0,0,0" Fill="{DynamicResource BorderBrush}"/>
                                </Grid>
                                <TextBlock FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="#"/><Run Text="{Binding ParentId}"/>
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Form 模式 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Margin="8,0,8,8">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PanelMode}"
                                                 Value="{x:Static localvm:ProductInOutPanelMode.Form}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>

                            <!-- 來料編號 -->
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource PioFormLotNo}"
                                     Text="{Binding FormLotNo, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"/>

                            <!-- 件號篩選 + 型號篩選 + 工序篩選 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0"
                                         materialDesign:HintAssist.Hint="{DynamicResource PioFormPartFilter}"
                                         Text="{Binding FormPartFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Margin="0"
                                         materialDesign:HintAssist.Hint="{DynamicResource PioFormModelFilter}"
                                         Text="{Binding FormModelFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="4" Margin="0"
                                         materialDesign:HintAssist.Hint="{DynamicResource PioFormProcessFilter}"
                                         Text="{Binding FormProcessFilter, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- 產品 ComboBox -->
                            <ComboBox materialDesign:HintAssist.Hint="{DynamicResource PioFormProduct}"
                                      ItemsSource="{Binding FilteredProducts}"
                                      SelectedItem="{Binding SelectedProduct}"
                                      Margin="0,0,0,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Part.PartNo}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Part.Brand}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Model.Name}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 無符合產品提示 -->
                            <TextBlock Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="11"
                                       Text="{DynamicResource PioFormNoProduct}"
                                       Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FilteredProducts.Count}" Value="0"/>
                                                    <Condition Binding="{Binding FormPartFilter, Converter={StaticResource StringHasValueToVisibilityConverter}}" Value="Visible"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FilteredProducts.Count}" Value="0"/>
                                                    <Condition Binding="{Binding FormModelFilter, Converter={StaticResource StringHasValueToVisibilityConverter}}" Value="Visible"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 工序 ComboBox -->
                            <ComboBox materialDesign:HintAssist.Hint="{DynamicResource PioFormProcess}"
                                      ItemsSource="{Binding FilteredProcesses}"
                                      SelectedItem="{Binding SelectedProcess}"
                                      DisplayMemberPath="Name"
                                      Margin="0,6,0,10"/>

                            <!-- 數量標題 -->
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{DynamicResource PioFormQty}"
                                       FontSize="12"
                                       Margin="0,0,0,4"/>
                            
                            <!-- 數量 -->
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource PioFormQty}"
                                     Text="{Binding FormQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"/>

                            <!-- 備註 -->
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource PioFormDescription}"
                                     Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"/>

                            <!-- 錯誤訊息 -->
                            <TextBlock Foreground="{DynamicResource ErrorBrush}"
                                       Text="{Binding FormError}"
                                       FontSize="12"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding FormError,
                                                    Converter={StaticResource StringHasValueToVisibilityConverter}}"/>

                            <!-- 取消 / 入料 按鈕 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource PioFormCancelButton}"
                                        Style="{DynamicResource FunctionButtonStyle}"
                                        Background="{DynamicResource BorderBrush}"
                                        Margin="0,0,8,0"
                                        Command="{Binding ClosePanelCommand}"/>
                                <Button Content="{DynamicResource PioFormSubmitButton}"
                                        Command="{Binding SubmitFormCommand}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
