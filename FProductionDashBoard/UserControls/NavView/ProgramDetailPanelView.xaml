<UserControl x:Class="FProductionDashBoard.UserControls.ProgramDetailPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:FProductionDashBoard"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="400">
    <UserControl.Resources>
        <local:TuningTypeToBrushConverter  x:Key="TuningTypeToBrushConverter"/>
        <local:TuningTypeToLabelConverter  x:Key="TuningTypeToLabelConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== Row0：標題列 ========== -->
        <Border Grid.Row="0" Padding="12,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左側：設備名 + 小統計 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCard.DeviceName}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,4"/>
                    <WrapPanel>
                        <!-- 可生產 -->
                        <TextBlock Text="{DynamicResource PlStatFeasible}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ProgramFeasibleBrush}"
                                   Margin="0,0,2,0"/>
                        <TextBlock Text="{Binding DetailFeasibleCount}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource ProgramFeasibleBrush}"
                                   Margin="0,0,12,0"/>
                        <!-- 帶點 -->
                        <TextBlock Text="{DynamicResource PlStatTeaching}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ProgramErrorBrush}"
                                   Margin="0,0,2,0"/>
                        <TextBlock Text="{Binding DetailTeachingCount}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource ProgramErrorBrush}"
                                   Margin="0,0,12,0"/>
                        <!-- 調品質 -->
                        <TextBlock Text="{DynamicResource PlStatOffset}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ProgramOffsetBrush}"
                                   Margin="0,0,2,0"/>
                        <TextBlock Text="{Binding DetailOffsetCount}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource ProgramOffsetBrush}"
                                   Margin="0,0,12,0"/>
                        <!-- 待審核 -->
                        <TextBlock Text="{DynamicResource PlStatPending}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ProgramPendingBrush}"
                                   Margin="0,0,2,0"/>
                        <TextBlock Text="{Binding DetailPendingCount}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource ProgramPendingBrush}"/>
                    </WrapPanel>
                </StackPanel>

                <!-- 右側：關閉按鈕 -->
                <Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding CloseDetailCommand}"
                        ToolTip="{DynamicResource PlDetailClose}"
                        VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- ========== Row1：程式清單 ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SelectedPrograms}" Margin="8,4,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="12,10"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource PrimaryBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel>

                                <!-- 第一行：SeqNo + PartNo -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock FontSize="11" Opacity="0.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <Binding Path="SeqNo" StringFormat="[{0}]"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Sop.Product.Part.PartNo}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- 第二行：Brand · Model · Process -->
                                <TextBlock FontSize="12" Opacity="0.65"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8">
                                    <Run Text="{Binding Sop.Product.Part.Brand, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Sop.Product.Model.Name, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Sop.Process.Name, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- 第三行：ProductionStatus Chip -->
                                <Grid HorizontalAlignment="Left">
                                    <!-- 暈色背景層 -->
                                    <Border CornerRadius="10"
                                            Background="{Binding ProductionStatus, Converter={StaticResource TuningTypeToBrushConverter}}"
                                            Opacity="0.15"/>
                                    <!-- 文字層 -->
                                    <Border CornerRadius="10" Padding="10,3">
                                        <TextBlock Text="{Binding ProductionStatus, Converter={StaticResource TuningTypeToLabelConverter}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding ProductionStatus, Converter={StaticResource TuningTypeToBrushConverter}}"/>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
