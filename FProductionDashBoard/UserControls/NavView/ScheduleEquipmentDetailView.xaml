<UserControl x:Class="FProductionDashBoard.UserControls.ScheduleEquipmentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localmod="clr-namespace:FProductionDashBoard.Models"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="500">

    <Grid Margin="4,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- stats bar -->
            <RowDefinition Height="*"/>     <!-- order DataGrid -->
        </Grid.RowDefinitions>

        <!-- Header：返回按鈕 + 設備名稱 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,8">
            <Button Content="{DynamicResource SchDetailBack}"
                    Style="{DynamicResource FunctionButtonStyle}"
                    Background="{DynamicResource SecondaryBrush}"
                    Padding="8,2" Height="Auto" Margin="0,0,10,0"
                    Command="{Binding DeselectEquipmentCardCommand}"/>
            <TextBlock Text="{Binding SelectedEquipmentCard.Name}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="4,0,0,0">
                <Run Text="("/>
                <Run Text="{Binding SelectedEquipmentCard.Code, Mode=OneWay}"/>
                <Run Text=")"/>
            </TextBlock>
        </StackPanel>

        <!-- Stats bar -->
        <Border Grid.Row="1" Style="{StaticResource StatCardBorderStyle}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="8,4">
                <!-- 待生產 -->
                <TextBlock Text="{DynamicResource SchDetailPending}"
                           Style="{StaticResource StatLabelStyle}" 
                           Margin="0"/>
                <TextBlock Text="{Binding EquipDetailPendingCount}"
                           FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="4,0"/>
                <TextBlock Text="/" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0"/>
                <TextBlock Text="{Binding EquipDetailPendingQty}"
                           FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="4,0"/>
                <TextBlock Text="{DynamicResource SchDetailUnit}"
                           Style="{StaticResource StatDenominatorStyle}" 
                           Margin="0" FontSize="12"/>

                <!-- 生產中 -->
                <TextBlock Text="{DynamicResource SchDetailInProduction}"
                           Style="{StaticResource StatLabelStyle}" 
                           Margin="12,0,0,0"/>
                <TextBlock Text="{Binding EquipDetailInProductionCount}"
                           FontSize="16" Foreground="{DynamicResource PrimaryBrush}"
                           Margin="4,0"/>
                <TextBlock Text="/" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0"/>
                <TextBlock Text="{Binding EquipDetailInProductionQty}"
                           FontSize="16" Foreground="{DynamicResource PrimaryBrush}"
                           Margin="4,0"/>
                <TextBlock Text="{DynamicResource SchDetailUnit}"
                           Style="{StaticResource StatDenominatorStyle}" 
                           Margin="0" FontSize="12"/>

                <!-- 可生產程式 -->
                <TextBlock Text="{DynamicResource SchDetailPrograms}"
                           Style="{StaticResource StatLabelStyle}" 
                           Margin="12,0,0,0"/>
                <TextBlock Text="{Binding SelectedEquipmentCard.TotalProgramCount}"
                           FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="4,0"/>

                <!-- 調試 chip -->
                <Border CornerRadius="6" Padding="6,2" Margin="6,0"
                        Background="{DynamicResource WarningBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedEquipmentCard.ActiveTuning}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{DynamicResource SchCardTuningLabel}"
                               FontSize="14" Foreground="{DynamicResource TextDarkBrush}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Order DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding SelectedEquipmentOrders}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  FontSize="13"
                  RowHeight="32"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
            <DataGrid.Columns>

                <!-- # -->
                <DataGridTextColumn Header="#"
                                    Binding="{Binding OrderId}"
                                    Width="50"/>

                <!-- 程式名稱 -->
                <DataGridTextColumn Header="{DynamicResource SchColPartNo}"
                                    Binding="{Binding ProductName}"
                                    Width="*"/>

                <!-- 製程 -->
                <DataGridTextColumn Header="{DynamicResource SchColProcess}"
                                    Binding="{Binding ProcessName}"
                                    Width="80"/>

                <!-- 狀態 Chip -->
                <DataGridTemplateColumn Header="{DynamicResource SchColStatus}" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="5,2" Margin="2,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource IdleBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static localmod:OrderProductionStatus.Pending}">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static localmod:OrderProductionStatus.InProduction}">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static localmod:OrderProductionStatus.Completed}">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static localmod:OrderProductionStatus.Cancelled}">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextLightBrush}"
                                           Text="{Binding Status,
                                                  Converter={StaticResource OrderProductionStatusToLabelConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 數量 -->
                <DataGridTextColumn Header="Qty"
                                    Binding="{Binding Quantity, TargetNullValue='-'}"
                                    Width="*"/>

                <!-- 操作按鈕 -->
                <DataGridTemplateColumn Header="" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Pending：開始 + 取消 -->
                                <Button Content="{DynamicResource SchOrderStart}"
                                        Background="{DynamicResource SuccessBrush}"
                                        Padding="4,2" Height="Auto" Margin="0,0,4,0"
                                        Command="{Binding DataContext.StartOrderProductionCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static localmod:OrderProductionStatus.Pending}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{DynamicResource SchOrderCancel}"
                                        Background="{DynamicResource ErrorBrush}"
                                        Padding="4,2" Height="Auto" Margin="0,0,4,0"
                                        Command="{Binding DataContext.CancelOrderProductionCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static localmod:OrderProductionStatus.Pending}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- InProduction：完成 -->
                                <Button Content="{DynamicResource SchOrderEnd}"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Padding="4,2" Height="Auto"
                                        Command="{Binding DataContext.EndOrderProductionCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static localmod:OrderProductionStatus.InProduction}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
