<UserControl x:Class="FProductionDashBoard.UserControls.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 未套用變更 Banner -->
        <Border Grid.Row="0"
                Background="{DynamicResource WarningBrush}"
                Padding="16,8"
                Visibility="{Binding HasUnsavedChanges,
                             Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource SsApplyButton}"
                        Style="{StaticResource ConfirmButtonStyle}"
                        Command="{Binding ApplyCommand}"/>
                <TextBlock Text="{DynamicResource SsUnsavedChanges}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDarkBrush}"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                <!-- 外觀 -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="16" Margin="0,0,0,16"
                        Background="{DynamicResource BackgroundBrush}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SsAppearanceHeader}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>
                        <!-- 語言 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource LanguageText}" VerticalAlignment="Center" Width="60"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <RadioButton Content="中文" Margin="0,0,12,0"
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     GroupName="LanguageGroup"
                                     IsChecked="{Binding CurrentLanguage,
                                         Converter={StaticResource EqualToConverter},
                                         ConverterParameter='zh-TW', Mode=OneWay}"
                                     Command="{Binding SetLanguageCommand}"
                                     CommandParameter="zh-TW"/>
                            <RadioButton Content="English" Margin="0,0,12,0"
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     GroupName="LanguageGroup"
                                     IsChecked="{Binding CurrentLanguage,
                                         Converter={StaticResource EqualToConverter},
                                         ConverterParameter='en-US', Mode=OneWay}"
                                     Command="{Binding SetLanguageCommand}"
                                     CommandParameter="en-US"/>
                            <RadioButton Content="Tiếng Việt"
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     GroupName="LanguageGroup"
                                     IsChecked="{Binding CurrentLanguage,
                                         Converter={StaticResource EqualToConverter},
                                         ConverterParameter='vi-VN', Mode=OneWay}"
                                     Command="{Binding SetLanguageCommand}"
                                     CommandParameter="vi-VN"/>
                        </StackPanel>
                        <!-- 主題 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource SsThemeLabel}" VerticalAlignment="Center" Width="60"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <RadioButton Content="{DynamicResource SsThemeLight}" Margin="0,0,12,0"
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding CurrentIsLight, Mode=OneWay}"
                                     Command="{Binding SetThemeCommand}"
                                     CommandParameter="False"/>
                            <RadioButton Content="{DynamicResource SsThemeDark}"
                                     Style="{StaticResource MaterialDesignRadioButton}"
                                     GroupName="ThemeGroup"
                                     IsChecked="{Binding CurrentIsDark, Mode=OneWay}"
                                     Command="{Binding SetThemeCommand}"
                                     CommandParameter="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 系統參數 -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource BackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SsSystemParamsHeader}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource SsBusinessStartTime}" VerticalAlignment="Center" Width="130"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Width="60" Margin="4,0"
                                 Text="{Binding BusinessHour, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource SsHourUnit}"/>
                            <TextBlock Text="{DynamicResource SsHourUnit}" VerticalAlignment="Center" Margin="4,0,16,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Width="60" Margin="4,0"
                                 Text="{Binding BusinessMinute, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource SsMinuteUnit}"/>
                            <TextBlock Text="{DynamicResource SsMinuteUnit}" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                   Text="{DynamicResource SsSkipLoginLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding SkipLoginScreen}"
                                      Style="{StaticResource SwitchToggleButtonStyle}"
                                      Margin="8,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 日誌管理 -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource BackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SsLogUploadHeader}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                        <!-- 自動儲存 Toggle -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsLogSaveToFile}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding LogSaveToFile}"
                                      Style="{StaticResource SwitchToggleButtonStyle}"
                                      Margin="8,0"/>
                        </Grid>

                        <!-- 保留天數 -->
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsLogDaysToKeep}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Width="60" Margin="8,0"
                                 Text="{Binding LogDaysToKeep, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding LogSaveToFile}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource SsDayUnit}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <Separator Margin="0,0,0,8"/>

                        <!-- Log 檔選取 + 上傳按鈕 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableLogFiles}"
                                  SelectedItem="{Binding SelectedLogFile}"
                                  Margin="0,0,8,0"/>
                            <Button Padding="5,0" Grid.Column="1"
                                Content="{DynamicResource SsLogUploadButton}"
                                Command="{Binding UploadLogCommand}"
                                Style="{StaticResource FunctionButtonStyle}"/>
                        </Grid>

                        <!-- 新增附件按鈕 -->
                        <Button Content="{DynamicResource SsLogAddAttachment}"
                            Command="{Binding AddAttachmentCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,0,4"/>

                        <!-- 附件清單 -->
                        <ListView ItemsSource="{Binding AttachmentPaths}"
                              Visibility="{Binding HasAttachments,
                                  Converter={StaticResource BooleanToVisibilityConverter}}"
                              MaxHeight="110" Margin="0,0,0,8"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Button Grid.Column="1"
                                            Command="{Binding DataContext.RemoveAttachmentCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GridEditButtonStyle}"
                                            Width="24" Height="24" Padding="0">
                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 進度條（上傳中才顯示） -->
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4"
                                 Visibility="{Binding IsUploading,
                                     Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- 上傳狀態文字 -->
                        <TextBlock Text="{Binding UploadStatus}" FontSize="12"
                               Visibility="{Binding UploadStatus,
                                   Converter={StaticResource StringHasValueToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUploadSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUploadSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 背景任務 -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource BackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SsBackgroundTasksHeader}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                        <!-- 卡片狀態刷新 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsCardRefreshLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding CardRefreshEnabled}"
                                      Style="{StaticResource SwitchToggleButtonStyle}"
                                      Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource SsEvery}" VerticalAlignment="Center" Margin="16,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="3" Width="60"
                                 Text="{Binding CardRefreshIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CardRefreshEnabled}"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource SsSecondUnit}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <!-- 圖表資料刷新 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsChartRefreshLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding ChartRefreshEnabled}"
                                      Style="{StaticResource SwitchToggleButtonStyle}"
                                      Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource SsEvery}" VerticalAlignment="Center" Margin="16,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="3" Width="60"
                                 Text="{Binding ChartRefreshIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding ChartRefreshEnabled}"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource SsSecondUnit}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <!-- 未巡檢偵測 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsMissedCheckLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding MissedCheckEnabled}"
                                      Style="{StaticResource SwitchToggleButtonStyle}"
                                      Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource SsEvery}" VerticalAlignment="Center" Margin="16,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="3" Width="60"
                                 Text="{Binding MissedCheckIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding MissedCheckEnabled}"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource SsSecondUnit}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <!-- 閒置登出 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsIdleLogoutLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IdleLogoutEnabled}"
                                      Style="{StaticResource SwitchToggleButtonStyle}"
                                      Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource SsEvery}" VerticalAlignment="Center" Margin="16,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="3" Width="60"
                                 Text="{Binding IdleLogoutIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IdleLogoutEnabled}"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource SsSecondUnit}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 硬體設定 -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource BackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SsHardwareHeader}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                        <!-- 讀卡機 -->
                        <TextBlock Text="{DynamicResource SsCardReaderSubHeader}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsCardReaderPort}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                 Text="{Binding ReaderPort, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsCardReaderBaud}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                 Text="{Binding ReaderBaud, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Separator Margin="0,0,0,12"/>

                        <!-- ABB 機械手 -->
                        <TextBlock Text="{DynamicResource SsAbbRobotSubHeader}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsAbbSeqNoTask}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                 Text="{Binding AbbSeqNoTask, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsAbbSeqNoModule}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                 Text="{Binding AbbSeqNoModule, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsAbbSeqNoVariable}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                 Text="{Binding AbbSeqNoVariable, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsAbbWriteSeqNoEnabled}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding AbbWriteSeqNoEnabled}"
                                          Style="{StaticResource SwitchToggleButtonStyle}"
                                          HorizontalAlignment="Left"
                                          Margin="8,0"/>
                        </Grid>

                        <Separator Margin="0,12,0,12"/>

                        <!-- 設備重連 -->
                        <TextBlock Text="{DynamicResource SsDeviceReconnectSubHeader}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsDeviceReconnect}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding DeviceReconnectEnabled}"
                                      Style="{StaticResource SwitchToggleButtonStyle}"
                                      Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource SsEvery}"
                                   VerticalAlignment="Center" Margin="16,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="3" Width="60"
                                 Text="{Binding DeviceReconnectIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding DeviceReconnectEnabled}"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource SsSecondUnit}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 金鑰與授權 -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    Background="{DynamicResource BackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SsKeyAndLicense}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>
                        <!-- AI API 金鑰 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SsAiApiKeyLabel}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" MaxWidth="200"
                                 Text="{Binding AiApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Separator Margin="0,12,0,12"/>

                        <!-- 授權狀態 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource SecondaryBrush}"
                                    CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding LicenseStatusText}"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- 客戶名稱（有值才顯示） -->
                        <TextBlock Text="{Binding LicenseCustomerName}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,0,0,4"
                                   Visibility="{Binding HasLicenseCustomerName,
                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- 剩餘天數（有授權期限才顯示） -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding HasLicenseDaysRemaining,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource LicenseDaysLeft}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding LicenseDaysRemainingText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                       Margin="8,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- 功能授權清單 -->
                        <StackPanel Margin="0,4,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Visibility="{Binding IsChartsEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Visibility="{Binding IsChartsEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter},
                                        ConverterParameter='Invert'}"/>
                                <TextBlock Text="{DynamicResource LicenseFeatureCharts}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Visibility="{Binding IsSchedulingEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Visibility="{Binding IsSchedulingEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter},
                                        ConverterParameter='Invert'}"/>
                                <TextBlock Text="{DynamicResource LicenseFeatureScheduling}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Visibility="{Binding IsProgramLibEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Visibility="{Binding IsProgramLibEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter},
                                        ConverterParameter='Invert'}"/>
                                <TextBlock Text="{DynamicResource LicenseFeatureProgramLib}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                    Foreground="{DynamicResource SuccessBrush}"
                                    Visibility="{Binding IsMaterialEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Visibility="{Binding IsMaterialEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter},
                                        ConverterParameter='Invert'}"/>
                                <TextBlock Text="{DynamicResource LicenseFeatureMaterial}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 匯入授權按鈕（PR1 disabled） -->
                        <Button Content="{DynamicResource LicenseImportButton}"
                                Command="{Binding ImportLicenseCommand}"
                                Style="{StaticResource FunctionButtonStyle}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
