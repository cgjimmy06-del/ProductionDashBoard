<UserControl x:Class="FProductionDashBoard.UserControls.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:localuc="clr-namespace:FProductionDashBoard.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <TabControl Style="{StaticResource MaterialDesignFilledTabControl}" Margin="4">

        <TabItem MinWidth="140">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <materialDesign:PackIcon Kind="Memory"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                    <TextBlock Text="設備管理" VerticalAlignment="Center"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                </StackPanel>
            </TabItem.Header>
            <localuc:EquipmentSettingView DataContext="{Binding Equipment}"/>
        </TabItem>

        <TabItem MinWidth="140">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <materialDesign:PackIcon Kind="AccountGroup"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                    <TextBlock Text="員工管理" VerticalAlignment="Center"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                </StackPanel>
            </TabItem.Header>
            <localuc:EmployeeSettingView DataContext="{Binding Employee}"/>
        </TabItem>

        <TabItem MinWidth="140">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <materialDesign:PackIcon Kind="Layers"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                    <TextBlock Text="材料管理" VerticalAlignment="Center"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                </StackPanel>
            </TabItem.Header>
            <localuc:MaterialSettingView DataContext="{Binding Material}"/>
        </TabItem>

    </TabControl>
</UserControl>
