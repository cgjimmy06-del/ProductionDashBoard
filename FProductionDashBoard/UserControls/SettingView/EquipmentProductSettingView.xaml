<UserControl x:Class="FProductionDashBoard.UserControls.EquipmentProductSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:FProductionDashBoard"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="35*"/>
            <ColumnDefinition Width="65*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左欄：機台篩選與選擇 ========== -->
        <Grid Grid.Column="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 標題 -->
            <TextBlock Grid.Row="0" Text="{DynamicResource EqprodEquipmentListTitle}"
                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>

            <!-- 篩選列：關鍵字 TextBox + 類型 ComboBox（橫向排列） -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,4,0"
                         materialDesign:HintAssist.Hint="{DynamicResource EqprodFilterKeyword}"
                         Text="{Binding KeywordFilter, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding EquipmentTypeFilterOptions}"
                          SelectedValue="{Binding TypeFilter}"
                          SelectedValuePath="Value"
                          materialDesign:HintAssist.Hint="{DynamicResource EqprodFilterType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Value.Name}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{DynamicResource EqprodTypeFilterAll}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- 機台清單 DataGrid -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding FilteredEquipmentList}"
                      SelectedItem="{Binding SelectedEquipment}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource SettingCodeDataGridHeader}" Binding="{Binding Code}" Width="*"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource SettingNameDataGridHeader}" Binding="{Binding Name}" Width="*"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource EqprodIp}" Binding="{Binding Ip}" Width="Auto"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ========== 右欄：可生產品項管理 ========== -->
        <Border Grid.Column="1" Margin="4"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MaxHeight="320"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 標題 + ProgressBar + ProductList DataGrid -->
                <Grid Grid.Row="0" Margin="8,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 標題列：機台資訊 + 篩選 + 新增按鈕 -->
                    <Grid Grid.Row="0" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedEquipment.Code, TargetNullValue='---'}"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" / "
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedEquipment.Name, TargetNullValue=''}"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Margin="8,0,4,0"
                                 VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="{DynamicResource EqprodProgramFilter}"
                                 Text="{Binding ProgramFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="{DynamicResource EqprodNewItemButton}"
                                Command="{Binding NewCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedEquipment}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 載入進度條 -->
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,0,4"
                                 Visibility="{Binding IsProductListLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- 可生產品項清單 -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredProductList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource EqprodSeqNo}" Binding="{Binding SeqNo}" Width="50"
                                                ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource EqprodPartNo}" Binding="{Binding Sop.Product.Part.PartNo}" Width="*"
                                                ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource EqprodBrand}" Binding="{Binding Sop.Product.Part.Brand}" Width="80"
                                                ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource EqprodModel}" Binding="{Binding Sop.Product.Model.Name}" Width="*"
                                                ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource EqprodProcess}" Binding="{Binding Sop.Process.Name}" Width="*"
                                                ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                            <DataGridTextColumn Header="{DynamicResource EqprodSopType}" Binding="{Binding Sop.SopType, Converter={StaticResource SopTypeToLabelConverter}}" Width="60"
                                                ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                            <DataGridTemplateColumn Header="{DynamicResource EqprodProductionStatus}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductionStatus, Converter={StaticResource TuningTypeToLabelConverter}}"
                                                   Style="{StaticResource CenterTextBlockStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource SettingActionDataGridHeader}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource GridEditButtonStyle}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource SettingEditTooltip}"
                                                    Foreground="{DynamicResource SecondaryBrush}">
                                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource GridEditButtonStyle}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource SettingDeleteTooltip}"
                                                    Foreground="{DynamicResource ErrorBrush}">
                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- GridSplitter -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource MaterialDesignDivider}"
                              Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Row 2: 新增/編輯表單 -->
                <Border Grid.Row="2"
                        Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Padding="12,8" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        Background="{DynamicResource PrimaryBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: 順序 + 搜尋關鍵字 -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock Text="{DynamicResource EqprodSeqNoLabel}"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding FormSeqNo, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="{DynamicResource EqprodSeqNoLabel}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4">
                                    <TextBlock Text="{DynamicResource EqprodSopSearchLabel}"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding SopKeywordFilter, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="{DynamicResource EqprodSopSearchTooltip}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: 產品 + 工序 -->
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock Text="{DynamicResource EqprodProductLabel}"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding FormProductOptions}"
                                              SelectedItem="{Binding FormProduct}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Part.PartNo, Mode=OneWay}"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding Model.Name, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4">
                                    <TextBlock Text="{DynamicResource EqprodProcessLabel}"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding FormProcessOptions}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding FormProcess}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: 生產狀態（常顯示）+ 類型（多 SopType 時才顯示） -->
                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock Text="{DynamicResource EqprodProductionStatusLabel}"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding ProductionStatusOptions}"
                                              SelectedItem="{Binding FormProductionStatus}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TuningTypeToLabelConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4"
                                            IsEnabled="{Binding IsSopTypeVisible}">
                                    <TextBlock Text="{DynamicResource EqprodSopTypeLabel}"
                                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox ItemsSource="{Binding FormSopTypeOptions}"
                                              SelectedItem="{Binding FormSopType}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SopTypeToLabelConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: 訊息 -->
                            <StackPanel Grid.Row="3">
                                <TextBlock Text="{Binding FormErrorString}" Margin="4,4,4,0"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           Visibility="{Binding FormErrorString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding FormSuccessString}" Margin="4,4,4,0"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Visibility="{Binding FormSuccessString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- Row 4: 按鈕 -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,4,4">
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        Command="{Binding CancelCommand}"
                                        Content="{DynamicResource CancelButton}"/>
                                <Button Command="{Binding SaveCommand}"
                                        Content="{DynamicResource SaveButton}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
