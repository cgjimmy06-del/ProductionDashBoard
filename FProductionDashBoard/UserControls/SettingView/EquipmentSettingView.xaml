<UserControl x:Class="FProductionDashBoard.UserControls.EquipmentSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MaxHeight="320" />
        </Grid.RowDefinitions>

        <!-- DataGrid -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,6">
                <Button Margin="0,0,8,0"
                        Command="{Binding SyncWithMesCommand}"
                        ToolTip="{DynamicResource EquipmentSetting_SyncWithMes}"
                        Style="{StaticResource FunctionButtonStyle}">
                    <materialDesign:PackIcon Kind="DatabaseSync" Margin="0" Width="30" Height="30"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                </Button>
                <Button Command="{Binding NewCommand}"
                        ToolTip="{DynamicResource NewButtonTooltip}"
                        Style="{StaticResource FunctionButtonStyle}">
                    <materialDesign:PackIcon Kind="Plus" Margin="0" Width="40" Height="40"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>

            <DataGrid Grid.Row="1" Margin="8,0,8,4"
                      ItemsSource="{Binding EquipmentList}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource SettingCodeDataGridHeader}" Binding="{Binding Code}" Width="Auto"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource SettingNameDataGridHeader}" Binding="{Binding Name}" Width="*"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="Auto"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="50"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource EquipmentFactoryDataGridHeader}" Binding="{Binding Factory}" Width="40"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource EquipmentBuildingDataGridHeader}" Binding="{Binding Building}" Width="40"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource EquipmentFloorDataGridHeader}" Binding="{Binding Floor}" Width="40"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource SettingTypeDataGridHeader}" Binding="{Binding Type.Name}" Width="80"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource SettingDescriptionDataGridHeader}" Binding="{Binding Description}" Width="1.5*"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="{DynamicResource SettingActionDataGridHeader}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource SettingEditTooltip}"
                                            Foreground="{DynamicResource SecondaryBrush}">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                    </Button>
                                    <Button Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource SettingDeleteTooltip}"
                                            Foreground="{DynamicResource ErrorBrush}">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesignDivider}"
                      Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Form Panel -->
        <Border Grid.Row="2"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="12,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource PrimaryBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding EditingId, StringFormat=編輯設備 (ID: {0}),
                           TargetNullValue=新增設備}"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="{DynamicResource SettingCodeRequiredLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource SettingCodeRequiredLabel}"
                                 Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="{DynamicResource SettingNameRequiredLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource SettingNameRequiredLabel}"
                                 Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                        <TextBlock Text="IP *" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox materialDesign:HintAssist.Hint="IP *"
                                 Text="{Binding FormIp, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                        <TextBlock Text="Port *" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBox materialDesign:HintAssist.Hint="Port *"
                                 Text="{Binding FormPort, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                        <TextBlock Text="{DynamicResource EquipmentTypeLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox ItemsSource="{Binding EquipmentTypes}"
                                  SelectedValuePath="TypeId"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding FormTypeId}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                        <TextBlock Text="{DynamicResource EquipmentFactoryDataGridHeader}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource EquipmentFactoryDataGridHeader}"
                                 Text="{Binding FormFactory, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                        <TextBlock Text="{DynamicResource EquipmentBuildingDataGridHeader}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource EquipmentBuildingDataGridHeader}"
                                 Text="{Binding FormBuilding, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="4">
                        <TextBlock Text="{DynamicResource EquipmentFloorDataGridHeader}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource EquipmentFloorDataGridHeader}"
                                 Text="{Binding FormFloor, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="4">
                        <TextBlock Text="{DynamicResource SettingNoteLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource SettingNoteLabel}"
                                 Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Error / Success messages -->
                <TextBlock Text="{Binding FormErrorString}" Margin="4,4,4,0"
                           Foreground="{DynamicResource ErrorBrush}"
                           Visibility="{Binding FormErrorString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>
                <TextBlock Text="{Binding FormSuccessString}" Margin="4,4,4,0"
                           Foreground="{DynamicResource SuccessBrush}"
                           Visibility="{Binding FormSuccessString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,4,4">
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Command="{Binding CancelCommand}"
                            Content="{DynamicResource CancelButton}"/>
                    <Button Command="{Binding SaveCommand}"
                            Content="{DynamicResource SaveButton}"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
