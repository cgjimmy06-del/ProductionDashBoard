<UserControl x:Class="FProductionDashBoard.UserControls.LocationSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MaxHeight="320" />
        </Grid.RowDefinitions>

        <!-- DataGrid -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" HorizontalAlignment="Right" Margin="8,6"
                    Command="{Binding NewCommand}"
                    ToolTip="{DynamicResource NewButtonTooltip}"
                    Style="{StaticResource FunctionButtonStyle}">
                <materialDesign:PackIcon Kind="Plus" Margin="0" Width="40" Height="40"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"/>
            </Button>

            <DataGrid Grid.Row="1" Margin="8,0,8,4"
                      ItemsSource="{Binding LocationList}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource SettingCodeDataGridHeader}" Binding="{Binding Code}" Width="Auto"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource WarehouseZoneLabel}" Binding="{Binding Zone}" Width="*"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource SettingTypeDataGridHeader}" Width="90"
                                        Binding="{Binding LocationType, Converter={StaticResource LocationTypeToLabelConverter}}"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource WarehouseCapacityLabel}" Binding="{Binding Capacity}" Width="70"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource WarehouseEquipmentLabel}" Binding="{Binding EquipmentName}" Width="*"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTextColumn Header="{DynamicResource WarehouseOccupancyHeader}" Binding="{Binding OccupancyCount}" Width="80"
                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="{DynamicResource WarehouseStatusHeader}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource WarehouseStatusEnabled}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Text" Value="{DynamicResource WarehouseStatusDisabled}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource SettingActionDataGridHeader}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource SettingEditTooltip}"
                                            Foreground="{DynamicResource SecondaryBrush}">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                    </Button>
                                    <Button Style="{StaticResource GridEditButtonStyle}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource SettingDeleteTooltip}"
                                            Foreground="{DynamicResource ErrorBrush}">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesignDivider}"
                      Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Form Panel -->
        <Border Grid.Row="2"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="12,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource PrimaryBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding EditingId, StringFormat=編輯倉位 (ID: {0}),
                               TargetNullValue=新增倉位}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="0.7*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 倉位編號 -->
                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="{DynamicResource SettingCodeRequiredLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource SettingCodeRequiredLabel}"
                                     Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="4,0" Padding="3"/>
                        </StackPanel>

                        <!-- 分區 -->
                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="{DynamicResource WarehouseZoneLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource WarehouseZoneLabel}"
                                     Text="{Binding FormZone, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="4,0" Padding="3"/>
                        </StackPanel>

                        <!-- 型別 -->
                        <StackPanel Grid.Column="2" Margin="4">
                            <TextBlock Text="{DynamicResource SettingTypeDataGridHeader}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding LocationTypes}"
                                      SelectedItem="{Binding FormLocationType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LocationTypeToLabelConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- 機邊設備（僅型別=機邊時啟用，緊接型別右側） -->
                        <StackPanel Grid.Column="3" Margin="4">
                            <TextBlock Text="{DynamicResource WarehouseEquipmentLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding EquipmentList}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding FormEquipmentId}"
                                      IsEnabled="{Binding IsMachineSide}"/>
                        </StackPanel>

                        <!-- 容量 -->
                        <StackPanel Grid.Column="4" Margin="4">
                            <TextBlock Text="{DynamicResource WarehouseCapacityLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox materialDesign:HintAssist.Hint="{DynamicResource WarehouseCapacityLabel}"
                                     Text="{Binding FormCapacity, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="4,0" Padding="3"/>
                        </StackPanel>

                        <!-- 啟用 -->
                        <StackPanel Grid.Column="5" Margin="4">
                            <TextBlock Text="{DynamicResource WarehouseEnabledLabel}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton HorizontalAlignment="Left" Margin="0,4,0,0"
                                          Style="{StaticResource SwitchToggleButtonStyle}"
                                          IsChecked="{Binding FormIsEnabled}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Error / Success messages -->
                    <TextBlock Text="{Binding FormErrorString}" Margin="4,4,4,0"
                               Foreground="{DynamicResource ErrorBrush}"
                               Visibility="{Binding FormErrorString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding FormSuccessString}" Margin="4,4,4,0"
                               Foreground="{DynamicResource SuccessBrush}"
                               Visibility="{Binding FormSuccessString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,4,4">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                Command="{Binding CancelCommand}"
                                Content="{DynamicResource CancelButton}"/>
                        <Button Command="{Binding SaveCommand}"
                                Content="{DynamicResource SaveButton}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
