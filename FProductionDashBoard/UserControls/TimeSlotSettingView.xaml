<UserControl x:Class="FProductionDashBoard.UserControls.TimeSlotSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MaxHeight="400" />
        </Grid.RowDefinitions>

        <!-- DataGrid -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" HorizontalAlignment="Left" Margin="8,6"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource FunctionButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="新增"/>
                </StackPanel>
            </Button>

            <DataGrid Grid.Row="1" Margin="8,0,8,4"
                      ItemsSource="{Binding TimeSlotList}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding TimeSlotId}" Width="50"/>
                    <DataGridTextColumn Header="開始時間" Binding="{Binding StartAt, Converter={StaticResource TimeSpanToHhmmConverter}}" Width="*"/>
                    <DataGridTextColumn Header="結束時間" Binding="{Binding EndAt, Converter={StaticResource TimeSpanToHhmmConverter}}" Width="*"/>
                    <DataGridCheckBoxColumn Header="跨日" Binding="{Binding IsCrossDay}" Width="60"/>
                    <DataGridTextColumn Header="標籤" Binding="{Binding Label}" Width="*"/>
                    <DataGridTemplateColumn Header="操作" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="編輯">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="刪除"
                                            Foreground="{DynamicResource ErrorBrush}">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesignDivider}"
                      Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Form Panel -->
        <Border Grid.Row="2"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="12,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource PrimaryBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding EditingId, StringFormat=編輯巡檢時段 (ID: {0}),
                               TargetNullValue=新增巡檢時段}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <!-- Row 0: ID / StartAt / EndAt -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ID -->
                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="ID" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding NextTimeSlotId, Mode=OneWay}"
                                     IsEnabled="False"/>
                        </StackPanel>

                        <!-- StartAt -->
                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="開始時間" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding HourItems}"
                                          SelectedItem="{Binding FormStartHour}"
                                          Width="70"
                                          materialDesign:HintAssist.Hint="時"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox ItemsSource="{Binding MinuteItems}"
                                          SelectedItem="{Binding FormStartMinute}"
                                          Width="60"
                                          materialDesign:HintAssist.Hint="分"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- EndAt -->
                        <StackPanel Grid.Column="2" Margin="4">
                            <TextBlock Text="結束時間" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding HourItems}"
                                          SelectedItem="{Binding FormEndHour}"
                                          Width="70"
                                          materialDesign:HintAssist.Hint="時"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ComboBox ItemsSource="{Binding MinuteItems}"
                                          SelectedItem="{Binding FormEndMinute}"
                                          Width="60"
                                          materialDesign:HintAssist.Hint="分"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: IsCrossDay / Label -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <CheckBox IsChecked="{Binding FormIsCrossDay}"
                                      Content="跨日 (IsCrossDay)"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="標籤 (自動產生)" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding ComputedLabel, Mode=OneWay}"
                                     IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- Error / Success messages -->
                    <TextBlock Text="{Binding FormErrorString}" Margin="4,4,4,0"
                               Foreground="{DynamicResource ErrorBrush}"
                               Visibility="{Binding FormErrorString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding FormSuccessString}" Margin="4,4,4,0"
                               Foreground="{DynamicResource SuccessBrush}"
                               Visibility="{Binding FormSuccessString, Converter={StaticResource StringHasValueToVisibilityConverter}}"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,4,4">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource PrimaryBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                Command="{Binding CancelCommand}"
                                Content="取消"/>
                        <Button Command="{Binding SaveCommand}"
                                Content="儲存"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
